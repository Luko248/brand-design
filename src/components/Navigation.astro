---
import { loadTranslations } from "@/lib/i18n";
import LanguageToggle from "./LanguageToggle.astro";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  isHomepage?: boolean;
}

const { lang, currentPath = "/", isHomepage = false } = Astro.props;
const global = await loadTranslations(lang, "global");
---

<nav
  data-nav
  data-home={isHomepage}
  class={`sticky top-0 z-[999] transition-[background-color,box-shadow,color] duration-300 ${
    isHomepage ? "text-[var(--color-white)]" : "nav-solid text-[var(--color-foreground)]"
  }`}
>
  <div class="max-w-screen-xl mx-auto px-4 lg:px-8 h-20 flex items-center gap-4 lg:gap-8">
    <a href="/" class="relative flex items-center gap-3">
      <img
        data-logo="light"
        src="/images/Logos/logo.svg"
        alt="Brand Design"
        class="h-12 w-auto transition-opacity duration-300 will-change-[opacity]"
      />
      <img
        data-logo="dark"
        src="/images/Logos/logo-black.svg"
        alt=""
        aria-hidden="true"
        class="h-12 w-auto absolute inset-0 opacity-0 transition-opacity duration-300 will-change-[opacity]"
      />
    </a>

    <div class="hidden lg:flex items-center gap-10 ml-auto text-sm uppercase tracking-[0.3rem] font-[Prometo-l]">
      <a class="nav-link" href="/#Home">{global.nav.home}</a>
      <a class="nav-link" href="/#About">{global.nav.about}</a>
      <a class="nav-link" href="/#References">{global.nav.references}</a>
      <a class="nav-link" href="/#Contact">{global.nav.contact}</a>
    </div>

    <div class="flex items-center gap-3 ml-auto lg:ml-6">
      <LanguageToggle lang={lang} currentPath={currentPath} />
      <button
        type="button"
        data-burger
        aria-controls="mobile-nav"
        aria-expanded="false"
        class="lg:hidden inline-flex h-11 w-11 items-center justify-center rounded-full border border-white/30 bg-white/10 text-white transition hover:bg-white/20 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]"
      >
        <span class="sr-only">Toggle navigation</span>
        <span class="burger-lines relative block h-[2px] w-6 bg-current transition-all duration-300">
          <span class="absolute -top-2 left-0 block h-[2px] w-6 bg-current transition-all duration-300"></span>
          <span class="absolute top-2 left-0 block h-[2px] w-6 bg-current transition-all duration-300"></span>
        </span>
      </button>
    </div>
  </div>

  <div
    data-overlay
    class="fixed inset-0 z-[998] bg-black/60 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  ></div>

  <div
    id="mobile-nav"
    data-menu
    class="fixed inset-y-0 right-0 z-[999] flex w-[calc(100%-4rem)] max-w-[22rem] translate-x-full flex-col gap-4 bg-white px-6 py-8 shadow-2xl transition-transform duration-300 sm:max-w-[26rem] lg:hidden"
  >
    <div class="flex items-center justify-between border-b border-black/10 pb-4">
      <img src="/images/Logos/logo-black.svg" alt="Brand Design" class="h-10 w-auto" />
      <button
        type="button"
        data-close
        class="inline-flex h-11 w-11 items-center justify-center rounded-full border border-black/10 text-black transition hover:bg-black/5 focus-visible:outline focus-visible:outline-2 focus-visible:outline-offset-2 focus-visible:outline-[var(--color-primary)]"
        aria-label="Close navigation"
      >
        <span class="relative block h-[2px] w-5 rotate-45 bg-current after:absolute after:left-0 after:top-0 after:block after:h-[2px] after:w-5 after:-rotate-90 after:bg-current"></span>
      </button>
    </div>
    <nav class="flex flex-col gap-3 text-base uppercase tracking-[0.25rem] font-[Prometo-l] text-black">
      <a class="mobile-link" href="/#Home">{global.nav.home}</a>
      <a class="mobile-link" href="/#About">{global.nav.about}</a>
      <a class="mobile-link" href="/#References">{global.nav.references}</a>
      <a class="mobile-link" href="/#Contact">{global.nav.contact}</a>
    </nav>
  </div>
</nav>

<style>
  [data-nav] {
    backdrop-filter: blur(12px);
    background-color: color-mix(in oklch, var(--color-background) 10%, transparent);
  }
  [data-nav].nav-solid {
    background-color: color-mix(in oklch, white 92%, var(--color-background) 8%);
    box-shadow: 0 10px 30px rgba(0, 0, 0, 0.08);
  }
  [data-nav].nav-solid .nav-link,
  [data-nav].nav-solid [data-logo="dark"] {
    color: var(--color-foreground);
    opacity: 1;
  }
  [data-nav].nav-solid [data-logo="light"] {
    opacity: 0;
  }
  .nav-link {
    position: relative;
    padding-bottom: 0.35rem;
    color: currentColor;
    transition: color 200ms ease, opacity 200ms ease;
  }
  .nav-link::after {
    content: "";
    position: absolute;
    left: 0;
    bottom: 0;
    height: 0.12rem;
    width: 100%;
    background: var(--color-primary);
    transform: scaleX(0);
    transform-origin: left;
    transition: transform 200ms ease;
  }
  .nav-link:hover::after,
  .nav-link:focus-visible::after {
    transform: scaleX(1);
  }
  [data-nav] [data-burger] {
    color: var(--color-white);
    border-color: rgba(255, 255, 255, 0.3);
    background-color: rgba(255, 255, 255, 0.06);
  }
  [data-nav].nav-solid [data-burger] {
    color: var(--color-foreground);
    border-color: rgba(0, 0, 0, 0.1);
    background-color: rgba(0, 0, 0, 0.03);
  }
  [data-nav] [data-burger]:hover {
    background-color: color-mix(in oklch, currentColor 20%, transparent);
  }
  .burger-open .burger-lines {
    background-color: transparent;
  }
  .burger-open .burger-lines span:first-child {
    transform: translateY(8px) rotate(45deg);
  }
  .burger-open .burger-lines span:last-child {
    transform: translateY(-8px) rotate(-45deg);
  }
  [data-menu][data-open="true"] {
    transform: translateX(0);
  }
  [data-overlay][data-open="true"] {
    opacity: 1;
    pointer-events: auto;
  }
  .mobile-link {
    padding: 0.75rem 0.25rem;
    border-bottom: 1px solid rgba(0, 0, 0, 0.08);
  }
  .mobile-link:last-child {
    border-bottom: none;
  }
</style>

<script is:inline>
  const nav = document.querySelector('[data-nav]');
  const burger = document.querySelector('[data-burger]');
  const closeBtn = document.querySelector('[data-close]');
  const menu = document.querySelector('[data-menu]');
  const overlay = document.querySelector('[data-overlay]');
  const links = menu?.querySelectorAll('a');
  const isHome = nav?.dataset.home === "true";

  const setMenuState = (open) => {
    if (!menu || !burger || !overlay) return;
    menu.dataset.open = open ? "true" : "false";
    overlay.dataset.open = open ? "true" : "false";
    burger.setAttribute("aria-expanded", open ? "true" : "false");
    burger.classList.toggle("burger-open", open);
    document.documentElement.classList.toggle("overflow-hidden", open);
    document.body.classList.toggle("overflow-hidden", open);
  };

  const closeMenu = () => setMenuState(false);

  burger?.addEventListener('click', () => {
    const isOpen = menu?.dataset.open === "true";
    setMenuState(!isOpen);
  });

  closeBtn?.addEventListener('click', closeMenu);
  overlay?.addEventListener('click', closeMenu);
  links?.forEach((link) => link.addEventListener('click', closeMenu));
  window.addEventListener('resize', () => {
    if (window.innerWidth >= 1024) {
      closeMenu();
    }
  });

  const applyScrollState = () => {
    if (!nav) return;
    const forceSolid = !isHome;
    const breakpointSolid = window.matchMedia('(max-width: 64rem)').matches;
    const shouldBeSolid = forceSolid || breakpointSolid || window.scrollY > 24;
    nav.classList.toggle('nav-solid', shouldBeSolid);
  };

  applyScrollState();
  window.addEventListener('scroll', applyScrollState, { passive: true });
  window.addEventListener('resize', applyScrollState, { passive: true });
</script>
