---
import { loadTranslations } from "@/lib/i18n";
import LanguageToggle from "./LanguageToggle.astro";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  isHomepage?: boolean;
}

const { lang, currentPath = "/", isHomepage = false } = Astro.props;
const global = await loadTranslations(lang, "global");
---

<nav class="nav" data-is-homepage={isHomepage}>
  <a href="/" class="nav__logo">
    <img src="/Resources/Images/Logos/logo.svg" alt="logo" />
    <img src="/Resources/Images/Logos/logo-black.svg" alt="logo-sec" />
  </a>
  <ul class="nav__menu">
    <li>
      <a href="/#Home" id="HomeScroll" class="nav__item nav__item--active">
        <span>{global.nav.home}</span>
      </a>
    </li>
    <li>
      <a href="/#About" id="AboutScroll" class="nav__item">
        <span>{global.nav.about}</span>
      </a>
    </li>
    <li>
      <a href="/#References" id="ReferencesScroll" class="nav__item">
        <span>{global.nav.references}</span>
      </a>
    </li>
    <li>
      <a href="/#Contact" id="ContactScroll" class="nav__item">
        <span>{global.nav.contact}</span>
      </a>
    </li>
  </ul>
  <div class="nav__right">
    <LanguageToggle lang={lang} currentPath={currentPath} />
    <div class="burger-button">
      <div></div>
    </div>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const burgerButton = document.querySelector('.burger-button');
    const menu = document.querySelector('.nav__menu');
    const navItems = document.querySelectorAll('.nav__item');
    const nav = document.querySelector('.nav');
    const isHomepage = nav?.getAttribute('data-is-homepage') === 'true';

    // Burger menu toggle
    if (burgerButton && menu) {
      burgerButton.addEventListener('click', (e) => {
        e.stopPropagation();
        burgerButton.classList.toggle('burger-button--open');
        menu.classList.toggle('nav__menu--open');
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('.burger-button') && !e.target.closest('.nav__menu')) {
          burgerButton.classList.remove('burger-button--open');
          menu.classList.remove('nav__menu--open');
        }
      });
    }

    // Nav item click
    navItems.forEach((item) => {
      item.addEventListener('click', () => {
        navItems.forEach((navItem) => navItem.classList.remove('nav__item--active'));
        item.classList.add('nav__item--active');
      });
    });

    // Scroll behavior ONLY on homepage
    if (nav && isHomepage && window.innerWidth > 768) {
      window.addEventListener('scroll', () => {
        if (window.scrollY > 50) {
          nav.classList.add('nav--fixed');
        } else {
          nav.classList.remove('nav--fixed');
        }
      });
    } else if (nav && !isHomepage) {
      // On other pages, always fixed
      nav.classList.add('nav--fixed');
    }

    // Update year
    const yearElement = document.getElementById('Year');
    if (yearElement) {
      yearElement.textContent = new Date().getFullYear().toString();
    }
  });
</script>
