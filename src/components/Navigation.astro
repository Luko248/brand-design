---
import { loadTranslations, getLocalizedPath } from "@/lib/i18n";
import LanguageToggle from "./LanguageToggle.astro";
import DesktopNav from "./navigation/DesktopNav.astro";
import MobileMenu from "./navigation/MobileMenu.astro";
import MobileMenuButton from "./navigation/MobileMenuButton.astro";
import Logo from "./navigation/Logo.astro";
import ThemeToggle from "./navigation/ThemeToggle.astro";
import { normalizePath, type ReferenceLink } from "@/lib/navigation";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  isHomepage?: boolean;
}

const { lang, currentPath = "/", isHomepage = false } = Astro.props;
const global = await loadTranslations(lang, "global");
const indexTranslations = await loadTranslations(lang, "pages/index");

const homeUrl = getLocalizedPath("/#home", lang);
const aboutUrl = getLocalizedPath("/#about", lang);
const referencesUrl = getLocalizedPath("/#references", lang);
const contactUrl = getLocalizedPath("/#contact", lang);

const referenceLinks: ReferenceLink[] = [
  {
    href: getLocalizedPath("/printing-and-production", lang),
    label: indexTranslations.services.printing.title,
  },
  {
    href: getLocalizedPath("/expositions", lang),
    label: indexTranslations.services.expositions.title,
  },
  {
    href: getLocalizedPath("/sticks", lang),
    label: indexTranslations.services.sticks.title,
  },
];
---

<header
  id="main-header"
  class:list={[
    "fixed top-0 w-full z-100 transition-all duration-300 group/header",
    isHomepage
      ? "text-foreground lg:text-white lg:group-[.is-scrolled]/header:text-foreground"
      : "text-foreground",
    "bg-background/80 backdrop-blur-md border-b border-white/10 dark:border-white/5 shadow-sm",
    isHomepage &&
      "lg:bg-transparent lg:backdrop-blur-none lg:border-b-0 lg:shadow-none lg:[&.is-scrolled]:bg-background/80 lg:[&.is-scrolled]:backdrop-blur-md lg:[&.is-scrolled]:border-b lg:[&.is-scrolled]:shadow-sm",
  ]}
  data-homepage={String(isHomepage)}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center h-16 relative">
      <!-- Logo -->
      <Logo homeUrl={homeUrl} isHomepage={isHomepage} />

      <!-- Desktop Navigation -->
      <DesktopNav
        homeUrl={homeUrl}
        aboutUrl={aboutUrl}
        referencesUrl={referencesUrl}
        contactUrl={contactUrl}
        referenceLinks={referenceLinks}
        currentPath={currentPath}
        global={global}
      />

      <!-- Actions -->
      <div class="flex items-center gap-4 ml-auto">
        <div class="hidden lg:flex items-center gap-6">
          <LanguageToggle lang={lang} currentPath={currentPath} />

          <ThemeToggle
            id="theme-toggle"
            title={global.nav.themeToggle}
            class="cursor-pointer"
            iconButtonClass={isHomepage
              ? "lg:hover:bg-foreground/10 lg:group-[.is-scrolled]/header:hover:bg-foreground/10"
              : ""}
          />
        </div>

        <!-- Mobile Actions -->
        <div class="lg:hidden flex items-center gap-1 h-full">
          <ThemeToggle
            id="theme-toggle-mobile"
            title={global.nav.themeToggle}
            class="flex items-center h-full"
          />

          <MobileMenuButton title={global.nav.openMenu} />
        </div>
      </div>
    </div>
  </div>

  <MobileMenu
    lang={lang}
    global={global}
    referenceLinks={referenceLinks}
    currentPath={currentPath}
    homeUrl={homeUrl}
    aboutUrl={aboutUrl}
    referencesUrl={referencesUrl}
    contactUrl={contactUrl}
  />
</header>

<script is:inline>
  (() => {
    const SELECTORS = {
      header: "main-header",
      mobileBtn: "mobile-menu-btn",
      mobileOverlay: "mobile-menu-overlay",
      mobileMenu: "mobile-menu",
      themeToggles: "#theme-toggle, #theme-toggle-mobile",
      navLinks: "[data-nav-link]",
    };

    const header = document.getElementById(SELECTORS.header);
    const isHomepage = header?.dataset.homepage === "true";

    // --- Utils ---
    const debounce = (fn, delay = 80) => {
      let timeout;
      return (...args) => {
        window.clearTimeout(timeout);
        timeout = window.setTimeout(() => fn(...args), delay);
      };
    };

    // --- Header Scroll State ---
    const syncHeaderState = () => {
      if (!header) return;
      if (window.scrollY > 0) {
        header.classList.add("is-scrolled");
      } else {
        header.classList.remove("is-scrolled");
      }
    };

    // --- Scroll Spy ---
    const initScrollSpy = () => {
      if (!isHomepage) return;

      const navLinks = document.querySelectorAll(SELECTORS.navLinks);
      const sections = Array.from(navLinks)
        .map((link) => {
          const id = link.dataset.navLink;
          const section = document.getElementById(id);
          return section ? { id, link, section } : null;
        })
        .filter(Boolean);

      if (!sections.length) return;

      let throttleTimer = null;

      const updateActiveState = (currentId) => {
        navLinks.forEach((link) => {
          if (link.dataset.navLink === currentId) {
            link.classList.add("is-active", "text-primary");
            link.setAttribute("aria-current", "true");
          } else {
            link.classList.remove("is-active", "text-primary");
            link.removeAttribute("aria-current");
          }
        });
      };

      const calculateActiveSection = () => {
        const scrollY = window.scrollY;
        const offset = 100; // Header offset + buffer
        const viewPosition = scrollY + offset;

        // Check if at bottom
        if (window.innerHeight + scrollY >= document.body.offsetHeight - 50) {
          return sections[sections.length - 1].id;
        }

        // Find current section
        for (const { id, section } of sections) {
          const top = section.offsetTop;
          const bottom = top + section.offsetHeight;
          if (top <= viewPosition && bottom > viewPosition) {
            return id;
          }
        }
        return "";
      };

      const onScroll = () => {
        if (throttleTimer) return;
        throttleTimer = setTimeout(() => {
          const activeId = calculateActiveSection();
          if (activeId) updateActiveState(activeId);
          throttleTimer = null;
        }, 100);
      };

      window.addEventListener("scroll", onScroll, { passive: true });

      // Initial Check
      const hash = window.location.hash.substring(1);
      const hasValidHash = sections.some((s) => s.id === hash);

      if (hasValidHash) {
        updateActiveState(hash);
      } else {
        const activeId = calculateActiveSection();
        if (activeId) updateActiveState(activeId);
      }

      // Re-check after load
      window.addEventListener("load", () =>
        setTimeout(() => {
          const activeId = calculateActiveSection();
          if (activeId) updateActiveState(activeId);
        }, 100)
      );
    };

    // --- Mobile Menu ---
    const initMobileMenu = () => {
      const mobileBtnWrapper = document.getElementById(SELECTORS.mobileBtn);
      const mobileBtn = mobileBtnWrapper?.querySelector("button");
      const overlay = document.getElementById(SELECTORS.mobileOverlay);
      const menu = document.getElementById(SELECTORS.mobileMenu);
      const links = menu?.querySelectorAll("a");

      if (!mobileBtn || !overlay || !menu) return;

      let isOpen = false;
      let savedScrollY = 0;

      const toggleMenu = (show) => {
        const shouldShow = show === undefined ? !isOpen : show;

        if (shouldShow) {
          savedScrollY = window.scrollY;
          document.body.style.top = `-${savedScrollY}px`;
          document.body.classList.add("is-menu-open");
          document.documentElement.classList.add("is-menu-open");
          menu.classList.remove("translate-x-full");
          overlay.classList.remove("opacity-0", "pointer-events-none");
          mobileBtn.classList.add("is-open");
          mobileBtn.setAttribute("aria-expanded", "true");
          isOpen = true;
        } else {
          document.body.classList.remove("is-menu-open");
          document.documentElement.classList.remove("is-menu-open");
          document.body.style.top = "";
          window.scrollTo(0, savedScrollY);
          menu.classList.add("translate-x-full");
          overlay.classList.add("opacity-0", "pointer-events-none");
          mobileBtn.classList.remove("is-open");
          mobileBtn.setAttribute("aria-expanded", "false");
          isOpen = false;
        }
      };

      mobileBtn.addEventListener("click", () => toggleMenu());
      overlay.addEventListener("click", () => toggleMenu(false));
      links?.forEach((link) =>
        link.addEventListener("click", () => toggleMenu(false))
      );

      window.addEventListener("resize", () => {
        if (window.innerWidth >= 1024) {
          toggleMenu(false);
        }
      });
    };

    // --- Theme Toggle ---
    const initThemeToggle = () => {
      const themeToggleWrappers = document.querySelectorAll(
        SELECTORS.themeToggles
      );

      const setTheme = (theme) => {
        document.documentElement.dataset.theme = theme;
        localStorage.setItem("theme", theme);
      };

      themeToggleWrappers.forEach((wrapper) => {
        const btn = wrapper.querySelector("button");
        btn?.addEventListener("click", () => {
          const current =
            document.documentElement.dataset.theme === "dark"
              ? "dark"
              : "light";
          setTheme(current === "dark" ? "light" : "dark");
        });
      });
    };

    // --- Initialization ---
    if (isHomepage) {
      window.addEventListener("scroll", debounce(syncHeaderState, 30), {
        passive: true,
      });
      syncHeaderState();
    }

    document.addEventListener("DOMContentLoaded", () => {
      initScrollSpy();
    });

    initMobileMenu();
    initThemeToggle();
  })();
</script>

<style is:inline>
  :global(.nav-link.is-active) {
    color: var(--color-primary);
  }

  :global(.nav-sub-link.is-active) {
    color: var(--color-primary);
  }
</style>
