---
import { loadTranslations, getLocalizedPath } from "@/lib/i18n";
import LanguageToggle from "./LanguageToggle.astro";
import ChevronDownIcon from "./icons/ChevronDownIcon.astro";
import IconButton from "./ui/IconButton.astro";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  isHomepage?: boolean;
}

const { lang, currentPath = "/", isHomepage = false } = Astro.props;
const global = await loadTranslations(lang, "global");
const indexTranslations = await loadTranslations(lang, "pages/index");

const homeUrl = getLocalizedPath("/#home", lang);
const aboutUrl = getLocalizedPath("/#about", lang);
const referencesUrl = getLocalizedPath("/#references", lang);
const contactUrl = getLocalizedPath("/#contact", lang);

const referenceLinks = [
  {
    href: getLocalizedPath("/printing-and-production", lang),
    label: indexTranslations.services.printing.title,
  },
  {
    href: getLocalizedPath("/expositions", lang),
    label: indexTranslations.services.expositions.title,
  },
  {
    href: getLocalizedPath("/sticks", lang),
    label: indexTranslations.services.sticks.title,
  },
];
---

<header
  id="main-header"
  class:list={[
    "fixed top-0 w-full z-[100] transition-all duration-300 group/header",
    isHomepage
      ? "text-foreground lg:text-white lg:group-[.is-scrolled]/header:text-foreground"
      : "text-foreground",
    "bg-background/80 backdrop-blur-md border-b border-white/10 dark:border-white/5 shadow-sm",
    isHomepage &&
      "lg:bg-transparent lg:backdrop-blur-none lg:border-b-0 lg:shadow-none lg:[&.is-scrolled]:bg-background/80 lg:[&.is-scrolled]:backdrop-blur-md lg:[&.is-scrolled]:border-b lg:[&.is-scrolled]:shadow-sm",
  ]}
  data-homepage={String(isHomepage)}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center h-16 relative">
      <!-- Logo -->
      <div class="flex items-center shrink-0">
        <a href={homeUrl} rel="home" class="relative z-50 group">
          <img
            src={import.meta.env.BASE_URL + "images/logos/logo-black.svg"}
            alt="Brand Design"
            class:list={[
              "h-7 lg:h-10 w-auto transition-all duration-300",
              isHomepage
                ? "dark:invert lg:group-[.is-scrolled]/header:invert-0 dark:lg:group-[.is-scrolled]/header:invert"
                : "dark:invert",
            ]}
          />
        </a>
      </div>

      <!-- Desktop Navigation -->
      <nav
        class="hidden lg:flex items-center gap-8 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
      >
        <a
          href={homeUrl}
          rel="section"
          class="text-sm whitespace-nowrap uppercase tracking-widest hover:text-primary transition-colors"
          >{global.nav.home}</a
        >
        <a
          href={aboutUrl}
          rel="section"
          class="text-sm whitespace-nowrap uppercase tracking-widest hover:text-primary transition-colors"
          >{global.nav.about}</a
        >

        <div class="relative group">
          <a
            href={referencesUrl}
            rel="section"
            class="text-sm whitespace-nowrap uppercase cursor-pointer tracking-widest hover:text-primary transition-colors flex items-center gap-1 anchor/nav-references"
          >
            {global.nav.references}
            <ChevronDownIcon
              class="w-4 h-4 group-hover:rotate-180 transition-transform duration-200"
            />
          </a>
          <div
            class="absolute anchored-bottom-center/nav-references w-56 py-2 mt-2 bg-background/95 backdrop-blur-md border border-white/10 rounded-xl shadow-xl opacity-0 translate-y-2 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-200 dark:border-white/10 dark:bg-surface/95"
          >
            {
              referenceLinks.map((link) => (
                <a
                  href={link.href}
                  rel="bookmark"
                  class="block whitespace-nowrap px-4 py-2 text-sm text-foreground hover:bg-primary/10 hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>

        <a
          href={contactUrl}
          rel="section"
          class="text-sm uppercase tracking-widest hover:text-primary transition-colors"
          >{global.nav.contact}</a
        >
      </nav>

      <!-- Actions -->
      <div class="flex items-center gap-4 ml-auto">
        <div class="hidden lg:flex items-center gap-6">
          <LanguageToggle lang={lang} currentPath={currentPath} />

          <div id="theme-toggle">
            <IconButton
              as="button"
              title={global.nav.themeToggle}
              size="sm"
              class={isHomepage
                ? "lg:hover:bg-foreground/10 lg:group-[.is-scrolled]/header:hover:bg-foreground/10"
                : ""}
            >
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5 block dark:hidden"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
                ></path>
              </svg>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5 hidden dark:block"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
                ></path>
              </svg>
            </IconButton>
          </div>
        </div>

        <!-- Mobile Menu Button -->
        <div class="lg:hidden flex items-center gap-3">
          <div id="theme-toggle-mobile">
            <IconButton as="button" title={global.nav.themeToggle} size="sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5 block dark:hidden"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
                ></path>
              </svg>
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5 hidden dark:block"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
                ></path>
              </svg>
            </IconButton>
          </div>

          <div id="mobile-menu-btn">
            <IconButton as="button" title={global.nav.openMenu} size="sm">
              <svg
                xmlns="http://www.w3.org/2000/svg"
                fill="none"
                viewBox="0 0 24 24"
                stroke-width="1.5"
                stroke="currentColor"
                class="w-5 h-5"
              >
                <path
                  stroke-linecap="round"
                  stroke-linejoin="round"
                  d="M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5"></path>
              </svg>
            </IconButton>
          </div>
        </div>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-black/40 backdrop-blur-md z-105 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-0 w-full h-dvh bg-background z-200 transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col"
  >
    <!-- Header with Logo and Close Button -->
    <div
      class="flex items-center justify-between p-4 border-b border-outline/20"
    >
      <a href={homeUrl} rel="home" class="flex-shrink-0">
        <img
          src={import.meta.env.BASE_URL + "images/logos/logo-black.svg"}
          alt="Brand Design"
          class="h-7 w-auto transition-all duration-300 dark:invert"
        />
      </a>
      <div id="close-menu-btn">
        <IconButton
          as="button"
          title={global.nav.closeMenu}
          size="sm"
          class="text-foreground hover:text-white"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-6 h-6"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M6 18L18 6M6 6l12 12"></path>
          </svg>
        </IconButton>
      </div>
    </div>

    <nav class="flex-1 overflow-y-auto py-6 px-6 flex flex-col gap-6">
      <div class="space-y-4">
        <a
          href={homeUrl}
          class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
          >{global.nav.home}</a
        >
        <a
          href={aboutUrl}
          class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
          >{global.nav.about}</a
        >
        <div class="space-y-3">
          <a
            href={referencesUrl}
            class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
            >{global.nav.references}</a
          >
          <div class="flex flex-col gap-4 pl-2 mt-2">
            {
              referenceLinks.map((link) => (
                <a
                  href={link.href}
                  class="block text-sm text-muted hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
        <a
          href={contactUrl}
          class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
          >{global.nav.contact}</a
        >
      </div>
    </nav>

    <div class="p-6 border-t border-outline/20">
      <LanguageToggle
        lang={lang}
        currentPath={currentPath}
        class="text-foreground"
        upwards={true}
      />
    </div>
  </div>
</header>

<script>
  // Scroll handling for homepage desktop sticky navigation
  const header = document.getElementById("main-header");
  const isHomepage = header?.dataset.homepage === "true";

  if (isHomepage) {
    const handleScroll = () => {
      // Check for lg breakpoint (1024px) to only apply sticky logic on desktop if desired,
      // but simpler to just toggle class and let CSS media queries handle the visual changes.
      // The CSS uses lg: prefix so this class won't affect mobile even if present.
      if (window.scrollY > 20) {
        header?.classList.add("is-scrolled");
      } else {
        header?.classList.remove("is-scrolled");
      }
    };

    window.addEventListener("scroll", handleScroll, { passive: true });
    handleScroll(); // Init
  }

  // Mobile menu handling
  const mobileBtnWrapper = document.getElementById("mobile-menu-btn");
  const closeBtnWrapper = document.getElementById("close-menu-btn");
  const mobileBtn = mobileBtnWrapper?.querySelector("button");
  const closeBtn = closeBtnWrapper?.querySelector("button");
  const overlay = document.getElementById("mobile-menu-overlay");
  const menu = document.getElementById("mobile-menu");
  const links = menu?.querySelectorAll("a");

  let scrollPosition = 0;

  function toggleMenu(show: boolean) {
    if (!menu || !overlay) return;

    if (show) {
      // Save current scroll position
      scrollPosition = window.scrollY;

      // Lock body scroll and maintain position
      document.body.style.position = "fixed";
      document.body.style.top = `-${scrollPosition}px`;
      document.body.style.width = "100%";

      menu.classList.remove("translate-x-full");
      overlay.classList.remove("opacity-0", "pointer-events-none");
    } else {
      menu.classList.add("translate-x-full");
      overlay.classList.add("opacity-0", "pointer-events-none");

      // Restore body scroll
      document.body.style.position = "";
      document.body.style.top = "";
      document.body.style.width = "";

      // Restore scroll position
      window.scrollTo(0, scrollPosition);
    }
  }

  mobileBtn?.addEventListener("click", () => toggleMenu(true));
  closeBtn?.addEventListener("click", () => toggleMenu(false));
  overlay?.addEventListener("click", () => toggleMenu(false));
  links?.forEach((link) =>
    link.addEventListener("click", () => toggleMenu(false))
  );

  // Close menu on resize if screen becomes large
  window.addEventListener("resize", () => {
    if (window.innerWidth >= 1024) {
      toggleMenu(false);
    }
  });

  // Theme toggle
  const themeToggleWrappers = document.querySelectorAll(
    "#theme-toggle, #theme-toggle-mobile"
  );

  function setTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("theme", theme);
  }

  themeToggleWrappers.forEach((wrapper) => {
    const btn = wrapper.querySelector("button");
    btn?.addEventListener("click", () => {
      const current =
        document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      setTheme(current === "dark" ? "light" : "dark");
    });
  });
</script>
