---
import { loadTranslations } from "@/lib/i18n";
import LanguageToggle from "./LanguageToggle.astro";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  isHomepage?: boolean;
}

const { lang, currentPath = "/", isHomepage = false } = Astro.props;
const global = await loadTranslations(lang, "global");
---

<nav class="nav absolute top-[5rem] left-0 w-full h-[6rem] flex items-center justify-between px-[15%] box-border bg-transparent transition-all duration-300 z-[999] shadow-[0_0_5px_0_transparent] data-[fixed=true]:fixed data-[fixed=true]:top-0 data-[fixed=true]:bg-white data-[fixed=true]:shadow-[0_0_5px_0_rgba(0,0,0,0.75)] xl:px-8" data-is-homepage={isHomepage}>
  <a href="/" class="nav__logo relative block w-[14rem] h-auto no-underline">
    <img src="/Resources/Images/Logos/logo.svg" alt="logo" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 block w-full opacity-100 transition-all duration-300" />
    <img src="/Resources/Images/Logos/logo-black.svg" alt="logo-sec" class="absolute top-1/2 left-1/2 -translate-x-1/2 -translate-y-1/2 block w-full opacity-0 transition-all duration-300 data-[fixed=true]:opacity-100" />
  </a>
  <ul class="nav__menu hidden md:flex flex-row flex-wrap items-center justify-center w-auto transition-all duration-300" id="NavMenu">
    <li class="ml-[5rem] xl:ml-12">
      <a href="/#Home" id="HomeScroll" class="nav__item relative block box-border leading-[6rem] text-right no-underline uppercase overflow-y-hidden z-[9999] before:absolute before:top-0 before:left-0 before:block before:content-[''] before:w-full before:h-[calc(100%-8px)] before:bg-transparent before:border-b-2 before:border-dashed before:border-white before:-translate-x-[110%] before:transition-all before:duration-300 before:-z-10 hover:before:translate-x-0 data-[active=true]:before:translate-x-0 md:before:top-[85%] md:before:left-8 md:before:w-[calc(100%-4rem)] md:before:h-[0.1rem] md:before:border-black md:before:translate-x-0" data-active>
        <span class="text-white text-[2rem] transition-all duration-300 data-[fixed=true]:text-black">{global.nav.home}</span>
      </a>
    </li>
    <li class="ml-[5rem] xl:ml-12">
      <a href="/#About" id="AboutScroll" class="nav__item relative block box-border leading-[6rem] text-right no-underline uppercase overflow-y-hidden z-[9999] before:absolute before:top-0 before:left-0 before:block before:content-[''] before:w-full before:h-[calc(100%-8px)] before:bg-transparent before:border-b-2 before:border-dashed before:border-white before:-translate-x-[110%] before:transition-all before:duration-300 before:-z-10 hover:before:translate-x-0 md:before:top-[85%] md:before:left-8 md:before:w-[calc(100%-4rem)] md:before:h-[0.1rem] md:before:border-black md:before:translate-x-0">
        <span class="text-white text-[2rem] transition-all duration-300 data-[fixed=true]:text-black">{global.nav.about}</span>
      </a>
    </li>
    <li class="ml-[5rem] xl:ml-12">
      <a href="/#References" id="ReferencesScroll" class="nav__item relative block box-border leading-[6rem] text-right no-underline uppercase overflow-y-hidden z-[9999] before:absolute before:top-0 before:left-0 before:block before:content-[''] before:w-full before:h-[calc(100%-8px)] before:bg-transparent before:border-b-2 before:border-dashed before:border-white before:-translate-x-[110%] before:transition-all before:duration-300 before:-z-10 hover:before:translate-x-0 md:before:top-[85%] md:before:left-8 md:before:w-[calc(100%-4rem)] md:before:h-[0.1rem] md:before:border-black md:before:translate-x-0">
        <span class="text-white text-[2rem] transition-all duration-300 data-[fixed=true]:text-black">{global.nav.references}</span>
      </a>
    </li>
    <li class="ml-[5rem] xl:ml-12">
      <a href="/#Contact" id="ContactScroll" class="nav__item relative block box-border leading-[6rem] text-right no-underline uppercase overflow-y-hidden z-[9999] before:absolute before:top-0 before:left-0 before:block before:content-[''] before:w-full before:h-[calc(100%-8px)] before:bg-transparent before:border-b-2 before:border-dashed before:border-white before:-translate-x-[110%] before:transition-all before:duration-300 before:-z-10 hover:before:translate-x-0 md:before:top-[85%] md:before:left-8 md:before:w-[calc(100%-4rem)] md:before:h-[0.1rem] md:before:border-black md:before:translate-x-0">
        <span class="text-white text-[2rem] transition-all duration-300 data-[fixed=true]:text-black">{global.nav.contact}</span>
      </a>
    </li>
  </ul>
  <div class="nav__right flex flex-row flex-nowrap items-center justify-end">
    <LanguageToggle lang={lang} currentPath={currentPath} />
    <button id="BurgerButton" class="md:hidden inline-flex items-center justify-center w-10 h-8 rounded-md bg-[color-mix(in_oklch,var(--color-white),transparent_90%)] text-[var(--color-white)] data-[open=true]:bg-[color-mix(in_oklch,var(--color-white),transparent_80%)] ml-4" aria-label="Open menu" aria-expanded="false">
      <span class="sr-only">Menu</span>
      <div class="w-6 h-0.5 bg-white relative">
        <div class="absolute -top-2 left-0 w-6 h-0.5 bg-white"></div>
        <div class="absolute top-2 left-0 w-6 h-0.5 bg-white"></div>
      </div>
    </button>
  </div>
  <div class="md:hidden hidden data-[open=true]:flex absolute top-[6rem] right-0 flex-col flex-nowrap items-flex-start justify-flex-start w-[30rem] max-w-none border-b-[2rem] border-b-white border-l border-l-[rgba(0,0,0,0.75)] translate-x-full transition-all duration-300 data-[open=true]:translate-x-0 sm:w-full sm:border-l-0 after:content-[''] after:absolute after:top-full after:left-0 after:block after:w-full after:h-screen after:bg-white after:border-l after:border-l-[rgba(0,0,0,0.75)] sm:after:border-l-0" id="MobileMenu">
    <ul class="flex flex-col w-full bg-white">
      <li class="ml-auto bg-white sm:self-start sm:mb-0"><a href="/#Home" class="block box-border pr-8 leading-[6rem] text-right no-underline uppercase sm:text-right relative before:absolute before:top-[85%] before:left-8 before:w-[calc(100%-4rem)] before:h-[0.1rem] before:border-b-2 before:border-black before:translate-x-0 data-[active=true]:before:border-[var(--color-primary)]" data-active><span class="text-black text-[2rem]">{global.nav.home}</span></a></li>
      <li class="ml-auto bg-white sm:self-start sm:mb-0"><a href="/#About" class="block box-border pr-8 leading-[6rem] text-right no-underline uppercase sm:text-right relative before:absolute before:top-[85%] before:left-8 before:w-[calc(100%-4rem)] before:h-[0.1rem] before:border-b-2 before:border-black before:translate-x-0"><span class="text-black text-[2rem]">{global.nav.about}</span></a></li>
      <li class="ml-auto bg-white sm:self-start sm:mb-0"><a href="/#References" class="block box-border pr-8 leading-[6rem] text-right no-underline uppercase sm:text-right relative before:absolute before:top-[85%] before:left-8 before:w-[calc(100%-4rem)] before:h-[0.1rem] before:border-b-2 before:border-black before:translate-x-0"><span class="text-black text-[2rem]">{global.nav.references}</span></a></li>
      <li class="ml-auto bg-white sm:self-start sm:mb-0"><a href="/#Contact" class="block box-border pr-8 leading-[6rem] text-right no-underline uppercase sm:text-right relative before:absolute before:top-[85%] before:left-8 before:w-[calc(100%-4rem)] before:h-[0.1rem] before:border-b-2 before:border-black before:translate-x-0"><span class="text-black text-[2rem]">{global.nav.contact}</span></a></li>
    </ul>
  </div>
</nav>

<script is:inline>
  document.addEventListener('DOMContentLoaded', () => {
    const burgerButton = document.getElementById('BurgerButton');
    const mobile = document.getElementById('MobileMenu');
    const nav = document.querySelector('nav');
    const isHomepage = nav?.getAttribute('data-is-homepage') === 'true';
    const navItems = nav?.querySelectorAll('.nav__item span');
    const logoSecondary = nav?.querySelector('img[alt="logo-sec"]');

    if (burgerButton && mobile) {
      burgerButton.addEventListener('click', (e) => {
        e.stopPropagation();
        const open = mobile.getAttribute('data-open') === 'true';
        mobile.setAttribute('data-open', (!open).toString());
        burgerButton.setAttribute('data-open', (!open).toString());
        burgerButton.setAttribute('aria-expanded', (!open).toString());
      });

      document.addEventListener('click', (e) => {
        if (!e.target.closest('#BurgerButton') && !e.target.closest('#MobileMenu')) {
          mobile.setAttribute('data-open', 'false');
          burgerButton.setAttribute('data-open', 'false');
          burgerButton.setAttribute('aria-expanded', 'false');
        }
      });
    }

    if (nav && isHomepage && window.innerWidth > 768) {
      window.addEventListener('scroll', () => {
        const isFixed = window.scrollY > 50;
        nav.setAttribute('data-fixed', isFixed.toString());
        
        // Update nav item colors
        navItems?.forEach(span => {
          span.setAttribute('data-fixed', isFixed.toString());
        });
        
        // Update logo visibility
        if (logoSecondary) {
          logoSecondary.setAttribute('data-fixed', isFixed.toString());
        }
      });
    } else if (nav && !isHomepage) {
      nav.setAttribute('data-fixed', 'true');
      navItems?.forEach(span => {
        span.setAttribute('data-fixed', 'true');
      });
      if (logoSecondary) {
        logoSecondary.setAttribute('data-fixed', 'true');
      }
    }

    const yearElement = document.getElementById('Year');
    if (yearElement) {
      yearElement.textContent = new Date().getFullYear().toString();
    }
  });
</script>
