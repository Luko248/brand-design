---
import { loadTranslations, getLocalizedPath } from "@/lib/i18n";
import LanguageToggle from "./LanguageToggle.astro";
import ChevronDownIcon from "./icons/ChevronDownIcon.astro";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  isHomepage?: boolean;
}

const { lang, currentPath = "/", isHomepage = false } = Astro.props;
const global = await loadTranslations(lang, "global");
const indexTranslations = await loadTranslations(lang, "pages/index");

const homeUrl = getLocalizedPath("/#Home", lang);
const aboutUrl = getLocalizedPath("/#About", lang);
const referencesUrl = getLocalizedPath("/#References", lang);
const contactUrl = getLocalizedPath("/#Contact", lang);

const referenceLinks = [
  {
    href: getLocalizedPath("/printing-and-production", lang),
    label: indexTranslations.services.printing.title,
  },
  {
    href: getLocalizedPath("/expositions", lang),
    label: indexTranslations.services.expositions.title,
  },
  {
    href: getLocalizedPath("/sticks", lang),
    label: indexTranslations.services.sticks.title,
  },
];
---

<header
  id="main-header"
  class:list={[
    "fixed top-0 w-full z-[100] transition-all duration-300",
    isHomepage
      ? "text-white bg-transparent"
      : "text-foreground bg-background/80 backdrop-blur-md border-b border-white/10 dark:border-white/5 shadow-sm",
  ]}
  data-homepage={String(isHomepage)}
>
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
    <div class="flex items-center justify-between h-20">
      <!-- Logo -->
      <a href="/" class="flex-shrink-0 relative z-50 group">
        <img
          src="/images/Logos/logo-black.svg"
          alt="Brand Design"
          class:list={[
            "h-10 w-auto transition-all duration-300",
            "dark:invert",
            isHomepage
              ? "invert group-[.scrolled]:invert-0 dark:group-[.scrolled]:invert"
              : "",
          ]}
        />
      </a>

      <!-- Desktop Navigation -->
      <nav class="hidden lg:flex items-center gap-8">
        <a
          href={homeUrl}
          class="text-sm uppercase tracking-widest hover:text-primary transition-colors"
          >{global.nav.home}</a
        >
        <a
          href={aboutUrl}
          class="text-sm uppercase tracking-widest hover:text-primary transition-colors"
          >{global.nav.about}</a
        >

        <div class="relative group">
          <a
            href={referencesUrl}
            class="text-sm uppercase cursor-pointer tracking-widest hover:text-primary transition-colors flex items-center gap-1 anchor/nav-references"
          >
            {global.nav.references}
            <ChevronDownIcon
              class="w-4 h-4 group-hover:rotate-180 transition-transform duration-200"
            />
          </a>
          <div
            class="absolute anchored-bottom-center/nav-references w-56 py-2 mt-2 bg-background/95 backdrop-blur-md border border-white/10 rounded-xl shadow-xl opacity-0 translate-y-2 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible transition-all duration-200 dark:border-white/10 dark:bg-surface/95"
          >
            {
              referenceLinks.map((link) => (
                <a
                  href={link.href}
                  class="block px-4 py-2 text-sm text-foreground hover:bg-primary/10 hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>

        <a
          href={contactUrl}
          class="text-sm uppercase tracking-widest hover:text-primary transition-colors"
          >{global.nav.contact}</a
        >
      </nav>

      <!-- Actions -->
      <div class="hidden lg:flex items-center gap-6">
        <LanguageToggle lang={lang} currentPath={currentPath} />

        <button
          id="theme-toggle"
          type="button"
          class="p-2 rounded-full hover:bg-white/10 transition-colors focus:outline-none focus:ring-2 focus:ring-primary"
          aria-label="Toggle theme"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5 block dark:hidden"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
            ></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5 hidden dark:block"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
            ></path>
          </svg>
        </button>
      </div>

      <!-- Mobile Menu Button -->
      <div class="lg:hidden flex items-center gap-4">
        <button
          id="theme-toggle-mobile"
          type="button"
          class="p-2 rounded-full hover:bg-white/10 transition-colors"
          aria-label="Toggle theme"
        >
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5 block dark:hidden"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M21.752 15.002A9.718 9.718 0 0118 15.75c-5.385 0-9.75-4.365-9.75-9.75 0-1.33.266-2.597.748-3.752A9.753 9.753 0 003 11.25C3 16.635 7.365 21 12.75 21a9.753 9.753 0 009.002-5.998z"
            ></path>
          </svg>
          <svg
            xmlns="http://www.w3.org/2000/svg"
            fill="none"
            viewBox="0 0 24 24"
            stroke-width="1.5"
            stroke="currentColor"
            class="w-5 h-5 hidden dark:block"
          >
            <path
              stroke-linecap="round"
              stroke-linejoin="round"
              d="M12 3v2.25m6.364.386l-1.591 1.591M21 12h-2.25m-.386 6.364l-1.591-1.591M12 18.75V21m-4.773-4.227l-1.591 1.591M5.25 12H3m4.227-4.773L5.636 5.636M15.75 12a3.75 3.75 0 11-7.5 0 3.75 3.75 0 017.5 0z"
            ></path>
          </svg>
        </button>

        <button
          id="mobile-menu-btn"
          type="button"
          class="p-2 -mr-2 rounded-md hover:bg-white/10 transition-colors focus:outline-none"
          aria-controls="mobile-menu"
          aria-expanded="false"
        >
          <span class="sr-only">Open main menu</span>
          <div class="w-6 h-5 relative flex flex-col justify-between">
            <span
              class="w-full h-0.5 bg-current transition-all duration-300 origin-left"
            ></span>
            <span class="w-full h-0.5 bg-current transition-all duration-300"
            ></span>
            <span
              class="w-full h-0.5 bg-current transition-all duration-300 origin-left"
            ></span>
          </div>
        </button>
      </div>
    </div>
  </div>

  <!-- Mobile Menu Overlay -->
  <div
    id="mobile-menu-overlay"
    class="fixed inset-0 bg-black/60 backdrop-blur-sm z-40 opacity-0 pointer-events-none transition-opacity duration-300 lg:hidden"
    aria-hidden="true"
  >
  </div>

  <!-- Mobile Menu -->
  <div
    id="mobile-menu"
    class="fixed inset-y-0 right-0 w-full max-w-sm bg-background shadow-2xl z-50 transform translate-x-full transition-transform duration-300 ease-in-out lg:hidden flex flex-col"
  >
    <div
      class="flex items-center justify-between p-6 border-b border-outline/20"
    >
      <img
        src="/images/Logos/logo-black.svg"
        alt="Brand Design"
        class="h-8 w-auto dark:invert"
      />
      <button
        id="close-menu-btn"
        type="button"
        class="p-2 -mr-2 rounded-md hover:bg-surface transition-colors text-foreground"
      >
        <span class="sr-only">Close menu</span>
        <svg
          xmlns="http://www.w3.org/2000/svg"
          fill="none"
          viewBox="0 0 24 24"
          stroke-width="1.5"
          stroke="currentColor"
          class="w-6 h-6"
        >
          <path
            stroke-linecap="round"
            stroke-linejoin="round"
            d="M6 18L18 6M6 6l12 12"></path>
        </svg>
      </button>
    </div>

    <nav class="flex-1 overflow-y-auto py-6 px-6 flex flex-col gap-6">
      <div class="space-y-4">
        <a
          href={homeUrl}
          class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
          >{global.nav.home}</a
        >
        <a
          href={aboutUrl}
          class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
          >{global.nav.about}</a
        >
        <div class="space-y-3">
          <a
            href={referencesUrl}
            class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
            >{global.nav.references}</a
          >
          <div class="pl-4 space-y-3 border-l-2 border-outline/20">
            {
              referenceLinks.map((link) => (
                <a
                  href={link.href}
                  class="block text-sm text-muted hover:text-primary transition-colors"
                >
                  {link.label}
                </a>
              ))
            }
          </div>
        </div>
        <a
          href={contactUrl}
          class="block text-lg font-medium uppercase tracking-wider text-foreground hover:text-primary transition-colors"
          >{global.nav.contact}</a
        >
      </div>

      <div
        class="mt-auto pt-6 border-t border-outline/20 flex items-center justify-between"
      >
        <LanguageToggle
          lang={lang}
          currentPath={currentPath}
          class="text-foreground"
        />
      </div>
    </nav>
  </div>
</header>

<script>
  // Scroll handling
  const header = document.getElementById("main-header");
  const isHomepage = header?.dataset.homepage === "true";

  function updateHeader() {
    if (!header) return;
    const scrolled = window.scrollY > 20;

    if (isHomepage) {
      if (scrolled) {
        header.classList.add(
          "bg-background/80",
          "backdrop-blur-md",
          "shadow-sm",
          "text-foreground"
        );
        header.classList.remove("bg-transparent", "text-white");
        header.querySelector(".group")?.classList.add("scrolled");
      } else {
        header.classList.remove(
          "bg-background/80",
          "backdrop-blur-md",
          "shadow-sm",
          "text-foreground"
        );
        header.classList.add("bg-transparent", "text-white");
        header.querySelector(".group")?.classList.remove("scrolled");
      }
    }
  }

  window.addEventListener("scroll", updateHeader);
  updateHeader();

  // Mobile menu handling
  const mobileBtn = document.getElementById("mobile-menu-btn");
  const closeBtn = document.getElementById("close-menu-btn");
  const overlay = document.getElementById("mobile-menu-overlay");
  const menu = document.getElementById("mobile-menu");
  const links = menu?.querySelectorAll("a");

  function toggleMenu(show: boolean) {
    if (!menu || !overlay) return;

    if (show) {
      menu.classList.remove("translate-x-full");
      overlay.classList.remove("opacity-0", "pointer-events-none");
      document.body.style.overflow = "hidden";
    } else {
      menu.classList.add("translate-x-full");
      overlay.classList.add("opacity-0", "pointer-events-none");
      document.body.style.overflow = "";
    }
  }

  mobileBtn?.addEventListener("click", () => toggleMenu(true));
  closeBtn?.addEventListener("click", () => toggleMenu(false));
  overlay?.addEventListener("click", () => toggleMenu(false));
  links?.forEach((link) =>
    link.addEventListener("click", () => toggleMenu(false))
  );

  // Theme toggle
  const themeToggles = document.querySelectorAll(
    "#theme-toggle, #theme-toggle-mobile"
  );

  function setTheme(theme: "light" | "dark") {
    document.documentElement.dataset.theme = theme;
    localStorage.setItem("theme", theme);
  }

  themeToggles.forEach((btn) => {
    btn.addEventListener("click", () => {
      const current =
        document.documentElement.dataset.theme === "dark" ? "dark" : "light";
      setTheme(current === "dark" ? "light" : "dark");
    });
  });
</script>
