---
import ChevronDownIcon from "@/components/icons/ChevronDownIcon.astro";
import { normalizePath } from "@/lib/navigation";

export interface ReferenceLink {
  href: string;
  label: string;
}

export interface Props {
  homeUrl: string;
  aboutUrl: string;
  referencesUrl: string;
  contactUrl: string;
  referenceLinks: ReferenceLink[];
  currentPath?: string;
  global: any; // Using any for now to match existing usage, ideally type it properly
}

const {
  homeUrl,
  aboutUrl,
  referencesUrl,
  contactUrl,
  referenceLinks,
  currentPath = "/",
  global,
} = Astro.props;

const normalizedCurrentPath = normalizePath(currentPath);

const isReferenceActive = referenceLinks.some(
  (link) => normalizePath(link.href) === normalizedCurrentPath
);
---

<nav
  class="hidden lg:flex items-center gap-8 absolute left-1/2 top-1/2 -translate-x-1/2 -translate-y-1/2"
>
  <a
    href={homeUrl}
    rel="section"
    data-nav-link="home"
    class:list={[
      "nav-link text-sm whitespace-nowrap uppercase tracking-widest transition-colors",
      "hover:text-primary",
    ]}>{global.nav.home}</a
  >
  <a
    href={aboutUrl}
    rel="section"
    data-nav-link="about"
    class:list={[
      "nav-link text-sm whitespace-nowrap uppercase tracking-widest transition-colors",
      "hover:text-primary",
    ]}>{global.nav.about}</a
  >

  <div class="relative group desktop-nav-item">
    <a
      href={referencesUrl}
      rel="section"
      data-nav-link="references"
      class:list={[
        "nav-link text-sm whitespace-nowrap uppercase cursor-pointer tracking-widest transition-colors flex items-center gap-1 anchor/nav-references",
        "hover:text-primary",
        isReferenceActive && "text-primary is-active",
      ]}
      aria-current={isReferenceActive ? "true" : undefined}
      aria-haspopup="true"
      aria-expanded="false"
    >
      {global.nav.references}
      <ChevronDownIcon
        class="w-4 h-4 group-hover:rotate-180 group-[.is-open]:rotate-180 transition-transform duration-200"
      />
    </a>
    <div
      class="absolute anchored-bottom-center/nav-references w-56 py-2 mt-2 bg-background/95 backdrop-blur-md border border-white/10 rounded-xl shadow-xl opacity-0 translate-y-2 invisible group-hover:opacity-100 group-hover:translate-y-0 group-hover:visible group-[.is-open]:opacity-100 group-[.is-open]:translate-y-0 group-[.is-open]:visible transition-all duration-200 dark:border-white/10 dark:bg-surface/95"
    >
      {
        referenceLinks.map((link) => (
          <a
            href={link.href}
            rel="bookmark"
            class:list={[
              "nav-sub-link block whitespace-nowrap px-4 py-2 text-sm text-foreground transition-colors",
              "hover:bg-primary/10 hover:text-primary",
              normalizePath(link.href) === normalizedCurrentPath &&
                "bg-primary/10 text-primary is-active",
            ]}
            aria-current={
              normalizePath(link.href) === normalizedCurrentPath
                ? "page"
                : undefined
            }
          >
            {link.label}
          </a>
        ))
      }
    </div>
  </div>

  <a
    href={contactUrl}
    rel="section"
    data-nav-link="contact"
    class:list={[
      "nav-link text-sm uppercase tracking-widest transition-colors",
      "hover:text-primary",
    ]}>{global.nav.contact}</a
  >
</nav>

<script>
  // Handle desktop nav dropdowns (hover on desktop, click on touch)
  const navItems = document.querySelectorAll(".desktop-nav-item");

  navItems.forEach((item) => {
    const link = item.querySelector("a");

    if (!link) return;

    // Handle click for touch devices
    link.addEventListener("click", (e) => {
      // Check if it's a touch device or if we want to enforce click behavior
      // We'll use a simple heuristic: if the menu is not open, prevent default and open it
      // If it's open, allow default (navigation) or close?
      // Based on user request "same as LanguageToggle", we toggle

      // Only intercept if the intent is likely to open the menu (e.g. touch)
      // Or simpler: Always prevent navigation on the parent link to serve as a toggle
      // Since the parent link is just a section anchor (#references) and the content is in sublinks,
      // it's safer to treat it as a toggle mechanism on interactive clicks.

      // Check if hover is supported
      const hasHover = window.matchMedia("(hover: hover)").matches;

      // On touch devices (no hover), click should toggle
      if (!hasHover) {
        e.preventDefault();
        e.stopPropagation();

        const isOpen = item.classList.contains("is-open");

        // Close all others
        navItems.forEach((other) => {
          if (other !== item) {
            other.classList.remove("is-open");
            other.querySelector("a")?.setAttribute("aria-expanded", "false");
          }
        });

        if (isOpen) {
          item.classList.remove("is-open");
          link.setAttribute("aria-expanded", "false");
        } else {
          item.classList.add("is-open");
          link.setAttribute("aria-expanded", "true");
        }
      }
    });
  });

  // Close on click outside
  document.addEventListener("click", (e) => {
    if (!(e.target as Element).closest(".desktop-nav-item")) {
      navItems.forEach((item) => {
        item.classList.remove("is-open");
        item.querySelector("a")?.setAttribute("aria-expanded", "false");
      });
    }
  });

  // Close on Escape
  document.addEventListener("keydown", (e) => {
    if (e.key === "Escape") {
      navItems.forEach((item) => {
        item.classList.remove("is-open");
        item.querySelector("a")?.setAttribute("aria-expanded", "false");
      });
    }
  });
</script>
