---
export interface Props {
  isHomepage?: boolean;
}

const { isHomepage = false } = Astro.props;
---

<div class="flex items-center shrink-0">
  <a href={"/"} rel="home" class="relative z-50 group">
    <img
      src={import.meta.env.BASE_URL + "images/logos/logo-black.svg"}
      alt="Brand Design"
      class:list={[
        "h-7 lg:h-10 w-auto transition-all duration-300",
        isHomepage
          ? "dark:invert lg:group-[.is-scrolled]/header:invert-0 dark:lg:group-[.is-scrolled]/header:invert"
          : "dark:invert",
      ]}
    />
  </a>
</div>
