---
export interface Props {
  lang: "cs" | "en";
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

// Get current URL without query params
const cleanPath = currentPath.split('?')[0];
const csUrl = cleanPath;
const enUrl = cleanPath + "?lang=en";
---

<div class="lang-switcher text-[1.8rem] font-medium text-white md:pr-8 md:text-black md:text-right" data-fixed="false">
  <a
    href={csUrl}
    data-active={lang === 'cs'}
    aria-label="Switch to Czech"
    class="no-underline text-white md:text-black data-[active=true]:text-[var(--color-secondary)] md:data-[active=true]:text-[var(--color-primary)] hover:text-[var(--color-secondary-hover)] transition-all duration-300"
  >Cz</a>
  <span class="text-white md:text-black"> / </span>
  <a
    href={enUrl}
    data-active={lang === 'en'}
    aria-label="Switch to English"
    class="no-underline text-white md:text-black data-[active=true]:text-[var(--color-secondary)] md:data-[active=true]:text-[var(--color-primary)] hover:text-[var(--color-secondary-hover)] transition-all duration-300"
  >En</a>
</div>
