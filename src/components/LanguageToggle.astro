---
export interface Props {
  lang: "cs" | "en";
  currentPath: string;
}

const { lang, currentPath } = Astro.props;

// Get current URL without query params
const cleanPath = currentPath.split('?')[0];
const csUrl = cleanPath;
const enUrl = cleanPath + "?lang=en";
---

<div class="flex items-center gap-2 text-base font-semibold">
  <a
    href={csUrl}
    data-active={lang === 'cs'}
    aria-label="Switch to Czech"
    class="no-underline text-[var(--color-white)] opacity-70 px-2 py-1 rounded-sm transition-opacity duration-[--duration-300] ease-[--ease-standard] hover:opacity-100 hover:bg-[color-mix(in_oklch,var(--color-white),transparent_90%)] data-[active=true]:opacity-100 data-[active=true]:bg-[color-mix(in_oklch,var(--color-white),transparent_80%)]"
  >CZ</a>
  <span class="text-[var(--color-white)] opacity-50">/</span>
  <a
    href={enUrl}
    data-active={lang === 'en'}
    aria-label="Switch to English"
    class="no-underline text-[var(--color-white)] opacity-70 px-2 py-1 rounded-sm transition-opacity duration-[--duration-300] ease-[--ease-standard] hover:opacity-100 hover:bg-[color-mix(in_oklch,var(--color-white),transparent_90%)] data-[active=true]:opacity-100 data-[active=true]:bg-[color-mix(in_oklch,var(--color-white),transparent_80%)]"
  >EN</a>
</div>
