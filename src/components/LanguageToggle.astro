---
import { getLocalizedPath } from "@/lib/i18n";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  class?: string;
}

const { lang, currentPath, class: className = "" } = Astro.props;

const basePath = currentPath || `${Astro.url.pathname}${Astro.url.search}`;
const csUrl = getLocalizedPath(basePath, "cs");
const enUrl = getLocalizedPath(basePath, "en");
---

<div
  class:list={[
    "flex items-center gap-1 text-sm font-medium uppercase tracking-wider",
    className,
  ]}
>
  <a
    href={csUrl}
    class:list={[
      "transition-colors duration-200 hover:text-primary",
      lang === "cs" ? "text-primary font-bold" : "opacity-70",
    ]}
    aria-label="Switch to Czech"
  >
    Cz
  </a>
  <span class="opacity-30">/</span>
  <a
    href={enUrl}
    class:list={[
      "transition-colors duration-200 hover:text-primary",
      lang === "en" ? "text-primary font-bold" : "opacity-70",
    ]}
    aria-label="Switch to English"
  >
    En
  </a>
</div>
