---
import { getLocalizedPath } from "@/lib/i18n";

export interface Props {
  lang: "cs" | "en";
  currentPath?: string;
  class?: string;
}

const { lang, currentPath, class: className = "" } = Astro.props;

const basePath = currentPath || Astro.url.pathname;
const csUrl = getLocalizedPath(basePath, "cs");
const enUrl = getLocalizedPath(basePath, "en");

// Generate unique anchor name
const anchorName = `lang-toggle-${Math.random().toString(36).substring(2, 9)}`;
---

<div class:list={["relative group language-toggle", className]}>
  <button
    type="button"
    class={`flex items-center gap-2 text-sm font-medium uppercase tracking-wider hover:text-primary transition-colors focus:outline-none anchor/${anchorName}`}
    aria-expanded="false"
    aria-haspopup="true"
  >
    <!-- New Language Icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      fill="none"
      viewBox="0 0 24 24"
      stroke-width="1.5"
      stroke="currentColor"
      class="size-6"
    >
      <path
        stroke-linecap="round"
        stroke-linejoin="round"
        d="m10.5 21 5.25-11.25L21 21m-9-3h7.5M3 5.621a48.474 48.474 0 0 1 6-.371m0 0c1.12 0 2.233.038 3.334.114M9 5.25V3m3.334 2.364C11.176 10.658 7.69 15.08 3 17.502m9.334-12.138c.896.061 1.785.147 2.666.257m-4.589 8.495a18.023 18.023 0 0 1-3.827-5.802"
      ></path>
    </svg>
    <!-- Arrow Icon -->
    <svg
      xmlns="http://www.w3.org/2000/svg"
      viewBox="0 0 20 20"
      fill="currentColor"
      class="w-4 h-4 transition-transform duration-200 group-hover:rotate-180 arrow-icon"
    >
      <path
        fill-rule="evenodd"
        d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z"
        clip-rule="evenodd"></path>
    </svg>
  </button>

  <div
    class={`anchored-bottom-right/${anchorName} w-40 py-2 mt-2 bg-background/95 backdrop-blur-md border border-white/10 rounded-xl shadow-xl opacity-0 translate-y-2 invisible group-hover:opacity-100 group-hover:visible group-hover:translate-y-0 transition-all duration-200 dark:border-white/10 dark:bg-surface/95 z-60`}
  >
    <a
      href={csUrl}
      class:list={[
        "flex items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-primary/10 hover:text-primary",
        lang === "cs"
          ? "text-primary font-bold bg-primary/5"
          : "text-foreground",
      ]}
      hreflang="cs"
    >
      <span class="w-5 text-center">🇨🇿</span>
      Čeština
    </a>
    <a
      href={enUrl}
      class:list={[
        "flex items-center gap-3 px-4 py-2.5 text-sm transition-colors hover:bg-primary/10 hover:text-primary",
        lang === "en"
          ? "text-primary font-bold bg-primary/5"
          : "text-foreground",
      ]}
      hreflang="en"
    >
      <span class="w-5 text-center">🇬🇧</span>
      English
    </a>
  </div>
</div>

<script>
  // Handle multiple language toggles (desktop/mobile)
  const toggles = document.querySelectorAll(".language-toggle");

  toggles.forEach((container) => {
    const button = container.querySelector("button");
    const dropdown = container.querySelector("div");
    const arrow = container.querySelector(".arrow-icon");

    if (!button || !dropdown || !arrow) return;

    function toggle(open: boolean) {
      if (open) {
        dropdown?.classList.remove("opacity-0", "translate-y-2", "invisible");
        arrow?.classList.add("rotate-180");
        button?.setAttribute("aria-expanded", "true");
      } else {
        dropdown?.classList.add("opacity-0", "translate-y-2", "invisible");
        arrow?.classList.remove("rotate-180");
        button?.setAttribute("aria-expanded", "false");
      }
    }

    button.addEventListener("click", (e) => {
      e.stopPropagation();
      const isOpen = button.getAttribute("aria-expanded") === "true";
      // Close all other toggles first
      toggles.forEach((c) => {
        if (c !== container) {
          const b = c.querySelector("button");
          const d = c.querySelector("div");
          const a = c.querySelector(".arrow-icon");
          d?.classList.add("opacity-0", "translate-y-2", "invisible");
          a?.classList.remove("rotate-180");
          b?.setAttribute("aria-expanded", "false");
        }
      });
      toggle(!isOpen);
    });

    // Close on click outside
    document.addEventListener("click", (e) => {
      if (!container.contains(e.target as Node)) {
        toggle(false);
      }
    });

    // Close on Escape
    container.addEventListener("keydown", (e) => {
      if ((e as KeyboardEvent).key === "Escape") {
        toggle(false);
        button.focus();
      }
    });
  });
</script>
