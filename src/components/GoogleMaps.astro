---
const { id = "BrandDesignMap", class: className = "" } = Astro.props;
---

<div data-map-container id={id} class={`w-full min-h-[18rem] sm:min-h-[24rem] rounded-xl overflow-hidden shadow-lg ${className}`}></div>

<script is:inline>
  import { Loader } from '@googlemaps/js-api-loader';

  const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
  const mapElement = document.currentScript?.previousElementSibling;

  if (!apiKey) {
    console.warn('Missing PUBLIC_GOOGLE_MAPS_API_KEY');
  }

  (async () => {
    if (!mapElement || !apiKey) return;

    try {
      const loader = new Loader({
        apiKey,
        version: 'weekly',
      });

      const [{ Map }, { Marker, AdvancedMarkerElement }] = await Promise.all([
        loader.importLibrary('maps'),
        loader.importLibrary('marker'),
      ]);

      const location = { lat: 49.371588, lng: 16.644021 };

      const map = new Map(mapElement, {
        center: location,
        zoom: 15,
        disableDefaultUI: true,
        zoomControl: true,
      });

      if (AdvancedMarkerElement) {
        new AdvancedMarkerElement({
          map,
          position: location,
          title: 'Brand DESIGN',
        });
      } else if (Marker) {
        new Marker({
          map,
          position: location,
          title: 'Brand DESIGN',
        });
      }
    } catch (err) {
      console.error('Google Maps load failed', err);
    }
  })();
</script>
