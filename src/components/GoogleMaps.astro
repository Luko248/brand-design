<div id="BrandDesignMap" class="w-full aspect-[var(--ratio-map)]"></div>

<script>
  import { Loader } from '@googlemaps/js-api-loader';

  const apiKey = import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY;
  const mapElement = document.getElementById('BrandDesignMap');

  if (!apiKey) {
    console.warn('Missing PUBLIC_GOOGLE_MAPS_API_KEY');
  }

  if (mapElement && apiKey) {
    const loader = new Loader({
      apiKey,
      version: 'weekly',
      libraries: ['marker'],
    });

    loader.load().then((google) => {
      const location = { lat: 49.407212, lng: 16.631153 };

      const map = new google.maps.Map(mapElement, {
        center: location,
        zoom: 15,
        disableDefaultUI: true,
        zoomControl: true,
      });

      // Prefer AdvancedMarker when library is available
      if (google.maps.marker && google.maps.marker.AdvancedMarkerElement) {
        const { AdvancedMarkerElement } = google.maps.marker;
        new AdvancedMarkerElement({
          map,
          position: location,
          title: 'Brand DESIGN',
        });
      } else {
        new google.maps.Marker({
          position: location,
          map,
          title: 'Brand DESIGN',
        });
      }
    }).catch((err) => {
      console.error('Google Maps load failed', err);
    });
  }
  </script>
