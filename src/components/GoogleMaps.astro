---
const { id = "BrandDesignMap", class: className = "" } = Astro.props;
const apiKey =
  import.meta.env.PUBLIC_GOOGLE_MAPS_API_KEY ||
  import.meta.env.GOOGLE_MAPS_API_KEY;
---

<div
  data-map-container
  data-api-key={apiKey}
  id={id}
  class:list={[
    "w-full min-h-[18rem] sm:min-h-[24rem] rounded-xl overflow-hidden shadow-lg",
    className,
  ]}
>
</div>

<script>
  import { Loader } from "@googlemaps/js-api-loader";

  const initMap = async (container: HTMLElement) => {
    const apiKey = container.dataset.apiKey;

    if (!apiKey) {
      console.error(
        "Google Maps: Missing API Key. Please set PUBLIC_GOOGLE_MAPS_API_KEY or GOOGLE_MAPS_API_KEY in your .env file."
      );
      return;
    }

    try {
      const loader = new Loader({
        apiKey,
        version: "weekly",
      });

      const [{ Map }, { AdvancedMarkerElement }] = await Promise.all([
        loader.importLibrary("maps"),
        loader.importLibrary("marker"),
      ]);

      const location = { lat: 49.371588, lng: 16.644021 };

      const map = new Map(container, {
        center: location,
        zoom: 15,
        disableDefaultUI: true,
        zoomControl: true,
        mapId: "bfd60e560367f0091f02eb99", // Custom Map ID
      });

      new AdvancedMarkerElement({
        map,
        position: location,
        title: "Brand DESIGN",
      });
    } catch (err) {
      console.error("Google Maps load failed:", err);
    }
  };

  // Initialize all maps
  document.querySelectorAll("[data-map-container]").forEach((el) => {
    initMap(el as HTMLElement);
  });
</script>
