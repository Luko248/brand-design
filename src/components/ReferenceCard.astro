---
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";

export interface Props {
  href: string;
  image: string;
  title: string;
  description: string;
  buttonLabel: string;
  eyebrowLabel: string;
  class?: string;
}

const {
  href,
  image,
  title,
  description,
  buttonLabel,
  eyebrowLabel,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "border aspect-4/3 md:aspect-3/4 border-indigo-200 hover:border-indigo-400 dark:border-white/40 dark:hover:border-white",
    "group relative flex flex-col overflow-hidden rounded-xl w-full shadow-sm transition-all duration-300 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
    className,
  ]}
>
  <!-- Background Image -->
  <div
    class="absolute inset-0 z-10 overflow-clip transition-transform duration-700 ease-out group-hover:scale-105"
  >
    <img
      src={image}
      alt={title}
      loading="lazy"
      decoding="async"
      width="1024"
      height="1365"
      class="w-full h-full object-cover absolute inset-0 scale-100 transition-transform duration-700 ease-out group-hover:scale-110"
    />
  </div>

  <!-- Gradient Overlay -->
  <div class="card-gradient pointer-events-none absolute inset-0 z-20"></div>

  <!-- Content -->
  <div
    class="relative z-30 flex flex-col justify-end h-full p-6 md:p-8 text-white"
  >
    <!-- Eyebrow -->
    <span
      class="text-primary text-xs font-bold tracking-[0.2em] uppercase mb-2"
    >
      {eyebrowLabel}
    </span>

    <!-- Title -->
    <h3
      class="font-display text-2xl md:text-3xl uppercase mb-1 leading-tight drop-shadow-md"
    >
      {title}
    </h3>

    <!-- Description -->
    <div class="pt-3">
      <p
        class="text-white/90 text-sm leading-relaxed line-clamp-3 font-light"
        set:html={description}
      />
    </div>

    <!-- Button Wrapper -->
    <div
      class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 group-hover:grid-rows-[1fr] card-button-wrapper mt-4"
    >
      <div class="overflow-hidden">
        <span
          class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase text-primary transition-all duration-300 opacity-0 translate-y-4 group-hover:opacity-100 group-hover:translate-y-0 card-button-content"
        >
          {buttonLabel}
          <ArrowRightIcon
            class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
          />
        </span>
      </div>
    </div>
  </div>
</a>

<style>
  .card-gradient {
    background-image: linear-gradient(
      to bottom,
      oklch(0.16 0.035 285 / 0.3),
      oklch(0.16 0.035 285 / 0.6),
      oklch(0.16 0.035 285 / 0.95)
    );
  }

  @media (width <= 768px) {
    .card-gradient {
      background-image: linear-gradient(
        to bottom,
        oklch(0.16 0.035 285 / 0.2) 0%,
        oklch(0.16 0.035 285 / 0.6) 40%,
        oklch(0.16 0.035 285 / 0.9) 70%,
        oklch(0.16 0.035 285 / 0.98) 100%
      );
    }
  }

  @media (hover: none), (pointer: coarse), (width <= 768px) {
    .card-button-wrapper {
      grid-template-rows: 1fr !important;
    }

    .card-button-content {
      opacity: 1 !important;
      transform: none !important;
      translate: 0 !important;
    }
  }
</style>
