---
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";

export interface Props {
  href: string;
  image: string;
  title: string;
  description: string;
  buttonLabel: string;
  eyebrowLabel: string;
  class?: string;
}

const {
  href,
  image,
  title,
  description,
  buttonLabel,
  eyebrowLabel,
  class: className,
} = Astro.props;
---

<a
  href={href}
  style="aspect-ratio: 3/4;"
  class:list={[
    "border border-white/40 hover:border-white",
    "group relative flex flex-col overflow-hidden rounded-xl w-full shadow-sm transition-all duration-300 hover:shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary",
    className,
  ]}
>
  <!-- Background Image -->
  <div
    class="absolute inset-0 z-10 overflow-clip bg-linear-to-b from-transparent via-white/20 to-surface transition-transform duration-700 ease-out group-hover:scale-105"
  >
    <img
      src={image}
      alt={title}
      loading="lazy"
      decoding="async"
      width="1024"
      height="1365"
      class="w-full h-full object-cover absolute inset-0 scale-100 transition-transform duration-700 ease-out group-hover:scale-110"
    />
  </div>

  <!-- Content -->
  <div
    class="relative z-20 flex flex-col justify-end h-full p-6 md:p-8 text-white"
  >
    <!-- Eyebrow -->
    <span
      class="text-primary text-xs font-bold tracking-[0.2em] uppercase mb-2 translate-y-4 opacity-0 transition-all duration-500 group-hover:translate-y-0 group-hover:opacity-100"
    >
      {eyebrowLabel}
    </span>

    <!-- Title -->
    <h3
      class="font-display text-2xl md:text-3xl uppercase mb-1 leading-tight transition-transform duration-500 group-hover:-translate-y-1 drop-shadow-md"
    >
      {title}
    </h3>

    <!-- Description & Button Wrapper -->
    <div
      class="grid grid-rows-[0fr] transition-[grid-template-rows] duration-500 group-hover:grid-rows-[1fr]"
    >
      <div class="overflow-hidden">
        <div
          class="pt-3 space-y-4 opacity-0 transition-opacity duration-500 delay-100 group-hover:opacity-100"
        >
          <p
            class="text-white/90 text-sm leading-relaxed line-clamp-3 font-light"
            set:html={description}
          />

          <span
            class="inline-flex items-center gap-2 text-xs font-bold tracking-[0.2em] uppercase text-primary transition-all duration-300"
          >
            {buttonLabel}
            <ArrowRightIcon
              class="w-4 h-4 transition-transform duration-300 group-hover:translate-x-1"
            />
          </span>
        </div>
      </div>
    </div>
  </div>
</a>
