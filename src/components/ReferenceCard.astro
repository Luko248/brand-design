---
import ArrowRightIcon from "@/components/icons/ArrowRightIcon.astro";

export interface Props {
  href: string;
  image: string;
  title: string;
  description: string;
  buttonLabel: string;
  eyebrowLabel: string;
  class?: string;
}

const {
  href,
  image,
  title,
  description,
  buttonLabel,
  eyebrowLabel,
  class: className,
} = Astro.props;
---

<a
  href={href}
  class:list={[
    "group relative grid grid-rows-subgrid overflow-hidden rounded-2xl shadow-xl focus:outline-none focus-visible:ring-2 focus-visible:ring-primary/80 aspect-3/4",
    className,
  ]}
>
  <!-- Aspect Ratio Strut: Forces the card to maintain 3/4 aspect ratio by pushing the grid rows -->
  <div
    class="col-start-1 row-start-1 row-span-3 w-full pointer-events-none invisible"
  >
  </div>

  <!-- Background Image -->
  <div
    class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110 z-0"
    style={`background-image: url('${image}')`}
  >
  </div>

  <!-- Gradient Overlay -->
  <div
    class="absolute inset-0 bg-gradient-to-b from-transparent via-black/50 to-black/90 z-10 pointer-events-none"
  >
  </div>

  <!-- Content (subgrid wrapper to handle animations and alignment) -->
  <div
    class="z-20 row-start-2 row-span-2 grid grid-rows-subgrid p-8 text-white transform transition-transform duration-500 translate-y-4 group-hover:translate-y-0"
  >
    <!-- Header: Eyebrow + Title + Description (Row 2 of parent, Row 1 of wrapper) -->
    <div class="flex flex-col justify-end space-y-2 row-start-1 self-end">
      <span
        class="text-primary text-xs font-bold tracking-widest uppercase mb-2 block opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100"
      >
        {eyebrowLabel}
      </span>

      <h3 class="font-display text-3xl uppercase mb-4 leading-tight">
        {title}
      </h3>

      <!-- Description -->
      <div
        class="overflow-hidden transition-[max-height,opacity,margin] duration-500 ease-out max-h-0 opacity-0 group-hover:max-h-40 group-hover:opacity-100 group-hover:mb-6"
      >
        <p
          class="text-white/80 text-sm leading-relaxed line-clamp-3"
          set:html={description}
        />
      </div>
    </div>

    <!-- CTA (Row 3 of parent, Row 2 of wrapper) -->
    <span
      class="row-start-2 inline-flex items-center gap-2 text-sm font-bold tracking-widest uppercase text-primary group-hover:gap-4 transition-all duration-300 self-start pt-4"
    >
      {buttonLabel}
      <ArrowRightIcon class="w-4 h-4" />
    </span>
  </div>
</a>
