---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Hero from "@/components/Hero.astro";
import Button from "@/components/ui/Button.astro";
import { loadTranslations, getLocalizedPath } from "@/lib/i18n";

export interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;
const translations = await loadTranslations(lang, "pages/index");

const referenceCards = [
  {
    href: getLocalizedPath("/printing-and-production", lang),
    image: "/images/Backgrounds/print_bg.jpg",
    ...translations.services.printing,
  },
  {
    href: getLocalizedPath("/expositions", lang),
    image: "/images/Backgrounds/exposition_bg.jpg",
    ...translations.services.expositions,
  },
  {
    href: getLocalizedPath("/sticks", lang),
    image: "/images/Backgrounds/stick_bg.jpg",
    ...translations.services.sticks,
  },
];
---

<BaseLayout lang={lang}>
  <Navigation lang={lang} currentPath="/" isHomepage={true} />
  
  <main>
    <!-- Hero Section -->
    <section id="Home">
      <Hero translations={translations.hero} />
    </section>

    <!-- About Section -->
    <section id="About" class="relative py-20 md:py-32 bg-surface overflow-hidden">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 relative z-10">
        <div class="grid md:grid-cols-2 gap-12 md:gap-20 items-center">
          <!-- Logo visual -->
          <div class="flex justify-center md:justify-start order-2 md:order-1">
            <div class="relative w-[80%] max-w-md aspect-square">
              <div class="absolute inset-0 bg-primary/20 rounded-full blur-3xl animate-pulse"></div>
              <img
                src="/images/Logos/logo-black.svg"
                alt="Brand Design Logo"
                class="relative z-10 w-full h-auto drop-shadow-2xl dark:invert transition-all duration-500 hover:scale-105"
              />
            </div>
          </div>

          <!-- Text Content -->
          <div class="order-1 md:order-2 space-y-8 text-center md:text-left">
            <!-- Hidden H1 for SEO -->
            <h1 class="sr-only" set:html={translations.about.mainTitle} />
            
            <div>
              <h2 class="font-display uppercase text-4xl md:text-5xl lg:text-6xl text-foreground mb-6 leading-tight">
                <span class="block text-primary text-lg font-bold tracking-[0.3em] mb-2 uppercase">About Us</span>
                <span set:html={translations.about.title} />
              </h2>
              <div class="h-1.5 w-24 bg-primary rounded-full mx-auto md:mx-0"></div>
            </div>

            <div class="space-y-6 text-lg md:text-xl text-muted font-light leading-relaxed">
              <p set:html={translations.about.paragraph1} />
              <p set:html={translations.about.paragraph2} />
            </div>
          </div>
        </div>
      </div>
    </section>

    <!-- Banner Parallax -->
    <section class="relative py-32 flex items-center justify-center overflow-hidden">
      <div class="absolute inset-0 z-0">
        <div 
          class="w-full h-full bg-fixed bg-cover bg-center"
          style="background-image: url('/images/Backgrounds/parallax-bg-1.jpg')"
        ></div>
        <div class="absolute inset-0 bg-black/70"></div>
      </div>

      <div class="relative z-10 max-w-4xl mx-auto px-4 text-center text-white space-y-8">
        <h3 class="font-display uppercase text-3xl md:text-5xl leading-snug" set:html={translations.banner.title} />
        
        <Button 
          as="a" 
          href="#Contact" 
          variant="outline" 
          size="lg"
          class="border-white text-white hover:bg-white hover:text-black text-lg tracking-widest uppercase min-w-[200px]"
        >
          {translations.banner.button}
        </Button>
      </div>
    </section>

    <!-- Services / References -->
    <section id="References" class="py-20 md:py-32 bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="text-center max-w-3xl mx-auto mb-16 md:mb-24">
          <span class="text-primary text-sm font-bold tracking-[0.3em] uppercase block mb-4">Our Work</span>
          <h2 class="font-display uppercase text-4xl md:text-5xl lg:text-6xl text-foreground mb-6">
            {translations.services.title}
          </h2>
          <p class="text-lg text-muted">
            {translations.services.subtitle || "Discover our portfolio of successful projects and branding solutions."}
          </p>
        </div>

        <div class="grid md:grid-cols-3 gap-8">
          {referenceCards.map((card) => (
            <a 
              href={card.href}
              class="group relative block h-[500px] overflow-hidden rounded-2xl shadow-xl"
            >
              <!-- Background Image -->
              <div 
                class="absolute inset-0 bg-cover bg-center transition-transform duration-700 group-hover:scale-110"
                style={`background-image: url('${card.image}')`}
              ></div>
              
              <!-- Overlay -->
              <div class="absolute inset-0 bg-gradient-to-t from-black/90 via-black/50 to-black/20 opacity-60 group-hover:opacity-80 transition-opacity duration-500"></div>

              <!-- Content -->
              <div class="absolute inset-0 p-8 flex flex-col justify-end text-white translate-y-4 group-hover:translate-y-0 transition-transform duration-500">
                <div class="transform transition-all duration-500 group-hover:-translate-y-4">
                  <span class="text-primary text-xs font-bold tracking-widest uppercase mb-2 block opacity-0 group-hover:opacity-100 transition-opacity duration-500 delay-100">Service</span>
                  <h3 class="font-display text-3xl uppercase mb-4 leading-tight">{card.title}</h3>
                  <p class="text-white/80 text-sm line-clamp-3 mb-6 opacity-0 h-0 group-hover:h-auto group-hover:opacity-100 transition-all duration-500 delay-200" set:html={card.description} />
                  
                  <span class="inline-flex items-center gap-2 text-sm font-bold tracking-widest uppercase text-primary group-hover:gap-4 transition-all duration-300">
                    {card.button}
                    <svg xmlns="http://www.w3.org/2000/svg" fill="none" viewBox="0 0 24 24" stroke-width="2" stroke="currentColor" class="w-4 h-4">
                      <path stroke-linecap="round" stroke-linejoin="round" d="M17.25 8.25L21 12m0 0l-3.75 3.75M21 12H3" />
                    </svg>
                  </span>
                </div>
              </div>
            </a>
          ))}
        </div>
      </div>
    </section>

    <!-- Partners -->
    <section class="py-20 bg-surface border-t border-outline/10">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 text-center">
        <h2 class="font-display uppercase text-3xl md:text-4xl text-foreground mb-12 opacity-80">
          {translations.partners.title}
        </h2>
        
        <div class="flex flex-wrap justify-center items-center gap-12 md:gap-20 opacity-60 hover:opacity-100 transition-opacity duration-500">
           <p class="text-xl font-light">{translations.partners.text}</p>
           <a href="https://www.mistrymont.cz/" target="_blank" class="transition-transform duration-300 hover:scale-110">
            <img
              src="/images/Logos/mistry-mont-logo.svg"
              alt="Mistry Mont"
              class="h-12 md:h-16 w-auto grayscale hover:grayscale-0 transition-all duration-300"
            />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
