---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { loadTranslations } from "@/lib/i18n";
import { getStickersCloudinaryData } from "@/lib/cloudinary";

export interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;
const translations = await loadTranslations(lang, "pages/sticks");

const { images: sticksImages, resources: sticksResources } =
  await getStickersCloudinaryData();
---

<BaseLayout
  lang={lang}
  title={translations.title}
  description={translations.description}
>
  <Navigation lang={lang} currentPath="/sticks" isHomepage={false} />

  <header
    class="relative h-[40vh] min-h-[400px] flex items-center justify-center overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-cover bg-center z-0"
      style="background-image: url('/images/backgrounds/stick_bg.jpg')"
    >
    </div>
    <div class="absolute inset-0 bg-black/60 z-10"></div>
    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto">
      <span
        class="block text-primary font-bold tracking-[0.3em] uppercase mb-4 animate-slide-up"
        >{translations.heading}</span
      >
      <h1
        class="font-display uppercase text-4xl md:text-6xl text-white mb-6 leading-tight animate-slide-up animation-delay-200"
      >
        {translations.title}
      </h1>
    </div>
  </header>

  <main>
    <section class="py-16 md:py-24 bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <p class="text-xl text-muted font-light leading-relaxed">
            {translations.description}
          </p>
          <div class="h-1 w-20 bg-primary rounded-full mx-auto mt-8"></div>
        </div>

        {
          sticksImages && sticksImages.length > 0 ? (
            <Gallery images={sticksImages} galleryId="sticks-gallery" />
          ) : (
            <p class="text-center text-muted text-lg font-light">
              {lang === "cs"
                ? "Něco se pokazilo při načítání galerie. Zkuste to prosím později."
                : "Something went wrong while loading the gallery. Please try again later."}
            </p>
          )
        }
      </div>
    </section>
  </main>

  <script is:inline define:vars={{ sticksResources }}>
    document.addEventListener("DOMContentLoaded", () => {
      if (Array.isArray(sticksResources) && sticksResources.length) {
        console.log("Cloudinary resources loaded for sticks gallery:", sticksResources);
      } else {
        console.warn("Cloudinary: No resources returned for sticks gallery.");
      }
    });
  </script>

  <Footer lang={lang} />
</BaseLayout>
