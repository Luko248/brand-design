---
import Button from "@/components/ui/Button.astro";

export interface Slide {
  image: string;
  titleHtml: string;
  ctaText: string;
  ctaHref: string;
}

export interface Props {
  slides: Slide[];
}

const { slides } = Astro.props;
---

<section class="slider relative w-full overflow-hidden text-[var(--color-white)]">
  <div id="HeroEmbla" class="overflow-hidden relative h-[100svh] max-h-[1080px]">
    <div data-embla-container class="flex h-full">
      {slides.map((s, i) => (
        <article
          data-active={i === 0}
          class="slider__item relative flex-[0_0_100%] min-w-0 h-full opacity-50 data-[active=true]:opacity-100 transition-opacity duration-[--duration-500] ease-[--ease-standard]"
          style={`background-image:url('${s.image}'); background-size:cover; background-position:center;`}
        >
          <div class="absolute inset-0 bg-hero-overlay"></div>
          <div class="slider__content absolute top-1/2 left-[15%] -translate-y-1/2 md:left-1/2 md:-translate-x-1/2 w-full box-border px-4 z-[2]">
            <h3 class="slider__title relative font-[var(--font-display)] text-[var(--text-hero)] font-medium tracking-[var(--letter-hero)] text-[var(--color-white)] opacity-0 data-[active=true]:opacity-100 data-[active=true]:animate-slide-title data-[active=true]:delay-300 md:text-center md:text-[var(--text-hero-sm)]">
              <span set:html={s.titleHtml} />
            </h3>
            <div class="mt-8 md:mx-auto md:w-max opacity-0 data-[active=true]:opacity-100 data-[active=true]:animate-slide-cta data-[active=true]:delay-600">
              <Button as="a" href={s.ctaHref} variant="outline" class="slider__button uppercase tracking-[0.2rem] text-[var(--text-2xl)] md:text-[var(--text-lg)] border-[var(--color-white)] text-[var(--color-white)] hover:bg-[var(--color-white)] hover:text-[var(--color-foreground)] px-8 py-4 md:px-4 md:py-2" >
                {s.ctaText}
              </Button>
            </div>
          </div>
        </article>
      ))}
    </div>
  </div>

  <div class="pointer-events-none absolute inset-x-0 top-0 bottom-0 z-[1] flex items-center justify-between px-4">
    <button id="HeroPrev" class="pointer-events-auto w-10 h-10 rounded-full bg-[color-mix(in_oklch,var(--color-white),transparent_85%)] text-[var(--color-foreground)] grid place-items-center" aria-label="Previous slide">‹</button>
    <button id="HeroNext" class="pointer-events-auto w-10 h-10 rounded-full bg-[color-mix(in_oklch,var(--color-white),transparent_85%)] text-[var(--color-foreground)] grid place-items-center" aria-label="Next slide">›</button>
  </div>

  <div class="absolute bottom-4 left-1/2 -translate-x-1/2 z-[2] flex gap-2">
    {slides.map((_, i) => (
      <button data-embla-dot class="w-3 h-3 rounded-full bg-[color-mix(in_oklch,var(--color-white),transparent_50%)] data-[active=true]:bg-[var(--color-white)]" aria-label={`Go to slide ${i+1}`}></button>
    ))}
  </div>
</section>

<!-- Embla initializer (bundled by Astro/Vite) -->
<script>
  import '/src/components/hero-slider-embla.ts'
  // No attributes ensures Astro processes this block and bundles the module.
  // The module reads timing tokens from CSS variables.
  void 0
  </script>
