---
export interface Props {
  /**
   * Element type: "a" for links, "button" for buttons, "div" for decorative usage.
   */
  as?: "a" | "button" | "div";
  href?: string;
  /**
   * Title attribute for hover tooltip / accessibility.
   */
  title?: string;
  rel?: string;
  /**
   * Optional utility classes for custom sizing/styling.
   */
  class?: string;
}

const { as = "button", href, title, rel = "nofollow", class: extraClass } =
  Astro.props;

const baseClasses =
  "inline-flex items-center justify-center rounded-full bg-transparent text-white/60 hover:text-white/90 hover:bg-white/10 hover:backdrop-blur-md transition-all duration-300";

const sizeClasses = "p-4 md:p-5";
const classes = `${baseClasses} ${sizeClasses}${extraClass ? ` ${extraClass}` : ""}`;
---

{as === "a" && href ? (
  <a href={href} title={title} rel={rel} class={classes}>
    <slot />
  </a>
) : as === "div" ? (
  <div title={title} class={classes}>
    <slot />
  </div>
) : (
  <button type="button" title={title} class={classes}>
    <slot />
  </button>
)}
