<script>
  // Optimize: Only run on desktop
  if (window.matchMedia("(min-width: 768px)").matches) {
    const container = document.getElementById("lava-container");
    let rafId: number | null = null;
    let mouseX = 0;
    let mouseY = 0;

    const updateStyles = () => {
      if (!container) return;

      // Calculate relative position (0 to 1)
      const x = mouseX / window.innerWidth;
      const y = mouseY / window.innerHeight;

      container.style.setProperty("--cursor-x", x.toString());
      container.style.setProperty("--cursor-y", y.toString());

      rafId = null;
    };

    const onMouseMove = (e: MouseEvent) => {
      mouseX = e.clientX;
      mouseY = e.clientY;

      if (!rafId) {
        rafId = requestAnimationFrame(updateStyles);
      }
    };

    // Initialize immediately to ensure it works, relying on RAF for performance
    document.addEventListener("mousemove", onMouseMove, { passive: true });
  }
</script>

