---
export interface Props {
  as?: 'a' | 'button';
  href?: string;
  variant?: 'primary' | 'secondary' | 'ghost' | 'outline';
  size?: 'sm' | 'md' | 'lg';
  disabled?: boolean;
  class?: string;
}

const props = Astro.props as Props;
const {
  as = 'a',
  href = undefined,
  variant = 'primary',
  size = 'md',
  disabled = false,
  class: className = '',
} = props;

const base = `inline-flex items-center justify-center gap-2 rounded-md font-medium transition-colors duration-[--duration-300] ease-[--ease-standard] focus-visible:outline-none`;

const sizes: Record<NonNullable<Props['size']>, string> = {
  sm: 'px-4 py-2 text-sm',
  md: 'px-6 py-3 text-base',
  lg: 'px-8 py-4 text-lg',
};
const sizeCls = sizes[size];

const variants: Record<NonNullable<Props['variant']>, string> = {
  primary: 'bg-[var(--color-primary)] text-[var(--color-white)] hover:bg-[var(--color-primary-hover)]',
  secondary: 'bg-[var(--color-secondary)] text-[var(--color-black)] hover:bg-[var(--color-secondary-hover)]',
  outline: 'bg-transparent text-[var(--color-primary)] border border-[var(--color-primary)] hover:bg-[color-mix(in_oklch,var(--color-primary),transparent_90%)]',
  ghost: 'bg-transparent text-[var(--color-foreground)] hover:bg-[color-mix(in_oklch,var(--color-white),transparent_90%)]',
};
const variantCls = variants[variant];

const disabledCls = disabled ? 'opacity-50 pointer-events-none' : '';
const all = `${base} ${sizeCls} ${variantCls} ${disabledCls} ${className}`.trim();
---
{as === 'a' ? (
  <a class={all} href={href}><slot /></a>
) : (
  <button class={all} disabled={disabled}><slot /></button>
)}
