---
import { loadTranslations } from "@/lib/i18n";
import GoogleMaps from "./GoogleMaps.astro";
import Button from "@/components/ui/Button.astro";

export interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;
const global = await loadTranslations(lang, "global");
const year = new Date().getFullYear();
---

<footer id="Contact" class="bg-surface text-foreground py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Top Section: Map & Contact Info -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <!-- Map -->
      <div
        class="w-full h-full min-h-[300px] rounded-3xl overflow-hidden shadow-lg ring-1 ring-black/5 dark:ring-white/10"
      >
        <GoogleMaps
          id="BrandDesignMap"
          class="w-full h-full min-h-[300px] lg:min-h-[400px]"
        />
      </div>

      <!-- Contact Info -->
      <div class="flex flex-col justify-center space-y-8">
        <div>
          <h2
            class="font-[Prometo-l] uppercase text-4xl md:text-5xl text-foreground mb-4"
          >
            {global.footer.contact}
          </h2>
          <div class="h-1 w-24 bg-primary rounded-full"></div>
        </div>

        <div class="grid sm:grid-cols-2 gap-10">
          <!-- Person -->
          <div class="space-y-4">
            <h4
              class="text-lg font-semibold uppercase tracking-wider text-muted"
            >
              {global.footer.contactPerson}
            </h4>
            <div class="space-y-1">
              <p class="text-xl font-medium">{global.company.contactName}</p>
              <a
                href={`mailto:${global.company.contactEmail}`}
                class="block text-primary hover:underline"
                >{global.company.contactEmail}</a
              >
              <a
                href={`tel:${global.company.phone}`}
                class="block text-primary hover:underline"
                >{global.company.phone}</a
              >
            </div>

            <!-- Socials -->
            <div class="flex items-center gap-4 pt-2">
              <a
                href="https://www.facebook.com/BENDER-dEsign-153757514682594/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-foreground hover:text-primary transition-colors"
                aria-label="Facebook"
              >
                <svg
                  class="w-6 h-6 fill-current"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    d="M24 12.073c0-6.627-5.373-12-12-12s-12 5.373-12 12c0 5.99 4.388 10.954 10.125 11.854v-8.385H7.078v-3.47h3.047V9.43c0-3.007 1.792-4.669 4.533-4.669 1.312 0 2.686.235 2.686.235v2.953H15.83c-1.491 0-1.962.925-1.962 1.874v2.25h3.328l-.532 3.47h-2.796v8.385C19.612 23.027 24 18.062 24 12.073z"
                  ></path></svg
                >
              </a>
              <a
                href="https://www.instagram.com/brand_design.cz/"
                target="_blank"
                rel="noopener noreferrer"
                class="text-foreground hover:text-primary transition-colors"
                aria-label="Instagram"
              >
                <svg
                  class="w-6 h-6 fill-current"
                  viewBox="0 0 24 24"
                  xmlns="http://www.w3.org/2000/svg"
                  ><path
                    d="M12 2.163c3.204 0 3.584.012 4.85.07 3.252.148 4.771 1.691 4.919 4.919.058 1.265.069 1.645.069 4.849 0 3.205-.012 3.584-.069 4.849-.149 3.225-1.664 4.771-4.919 4.919-1.266.058-1.644.07-4.85.07-3.204 0-3.584-.012-4.849-.07-3.26-.149-4.771-1.699-4.919-4.92-.058-1.265-.07-1.644-.07-4.849 0-3.204.013-3.583.07-4.849.149-3.227 1.664-4.771 4.919-4.919 1.266-.057 1.645-.069 4.849-.069zM12 0C8.741 0 8.333.014 7.053.072 2.695.272.273 2.69.073 7.052.014 8.333 0 8.741 0 12c0 3.259.014 3.668.072 4.948.2 4.358 2.618 6.78 6.98 6.98C8.333 23.986 8.741 24 12 24c3.259 0 3.668-.014 4.948-.072 4.354-.2 6.782-2.618 6.979-6.98.059-1.28.073-1.689.073-4.948 0-3.259-.014-3.667-.072-4.947-.196-4.354-2.617-6.78-6.979-6.98C15.668.014 15.259 0 12 0zm0 5.838a6.162 6.162 0 100 12.324 6.162 6.162 0 000-12.324zm0 10.162a3.999 3.999 0 110-7.998 3.999 3.999 0 010 7.998zm6.406-11.845a1.44 1.44 0 100 2.881 1.44 1.44 0 000-2.881z"
                  ></path></svg
                >
              </a>
            </div>
          </div>

          <!-- Address -->
          <div class="space-y-4">
            <h4
              class="text-lg font-semibold uppercase tracking-wider text-muted"
            >
              {global.footer.address}
            </h4>
            <address
              class="not-italic text-base leading-relaxed text-foreground/80"
            >
              {global.company.street}<br />
              {global.company.zip}
              {global.company.city}<br />
              IČO: {global.company.ico}
            </address>
            <div class="pt-2">
              <Button
                as="a"
                href={`mailto:${global.company.email}`}
                variant="primary"
                class="w-full sm:w-auto"
              >
                {global.footer.writeMessage}
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="border-t border-outline/20 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-muted"
    >
      <p>© {year} {global.company.name} — {global.footer.allRightsReserved}</p>
      <p>
        {global.footer.createdBy}
        <a
          href="https://lukaschylik.sk/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:underline font-medium">Lukáš Chylík</a
        >
      </p>
    </div>
  </div>
</footer>
