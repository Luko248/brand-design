---
import { loadTranslations } from "@/lib/i18n";
import GoogleMaps from "./GoogleMaps.astro";
import Button from "@/components/ui/Button.astro";
import EnvelopeIcon from "./icons/EnvelopeIcon.astro";
import PhoneIcon from "./icons/PhoneIcon.astro";
import SendIcon from "./icons/SendIcon.astro";

export interface Props {
  lang: "cs" | "en";
}

const { lang } = Astro.props;
const global = await loadTranslations(lang, "global");
const year = new Date().getFullYear();
---

<footer id="contact" class="bg-surface text-foreground py-16 lg:py-24">
  <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8 space-y-16">
    <!-- Top Section: Map & Contact Info -->
    <div class="grid lg:grid-cols-2 gap-12 lg:gap-20 items-start">
      <!-- Map -->
      <div
        class="w-full h-full min-h-[300px] rounded-xl overflow-hidden border border-indigo-200 hover:border-indigo-400 dark:border-white/40 dark:hover:border-white shadow-sm hover:shadow-xl transition-all duration-300 order-2 lg:order-0 animate-reveal-footer"
      >
        <GoogleMaps
          id="BrandDesignMap"
          class="w-full h-full min-h-[300px] lg:min-h-[400px]"
        />
      </div>

      <!-- Contact Info -->
      <div
        class="flex flex-col justify-center space-y-8 order-1 lg:order-0 animate-reveal-footer"
      >
        <div>
          <h2
            class="font-display uppercase text-4xl md:text-5xl text-foreground mb-4"
          >
            {global.footer.contact}
          </h2>
          <div class="h-1 w-24 bg-primary rounded-full"></div>
        </div>

        <div class="grid sm:grid-cols-2 gap-10 lg:gap-20">
          <!-- Address -->
          <div class="space-y-8">
            <div class="space-y-4">
              <h4
                class="text-lg font-semibold uppercase tracking-wider text-muted"
              >
                {global.footer.address}
              </h4>
              <address class="not-italic text-base leading-relaxed">
                {global.company.street}<br />
                {global.company.zip}, {global.company.city}
              </address>
            </div>

            <div class="space-y-4">
              <h4
                class="text-lg font-semibold uppercase tracking-wider text-muted"
              >
                {global.footer.billingAddress}
              </h4>
              <address class="not-italic text-base leading-relaxed">
                <strong>{global.company.legalName}</strong><br />
                {global.company.billingStreet}<br />
                {global.company.billingCity}<br />
                {global.company.billingCityLine2}
                <span class="block mt-2 text-muted">
                  {global.company.icoLabel}: {global.company.ico}
                </span>
              </address>
            </div>
          </div>

          <!-- Person -->
          <div class="space-y-4">
            <h4
              class="text-lg font-semibold uppercase tracking-wider text-muted"
            >
              {global.footer.contactPerson}
            </h4>
            <div class="space-y-2 grid gap-4">
              <div class="flex flex-col gap-2">
                <p class="text-xl font-medium">{global.company.contactName}</p>
                <a
                  href="mailto:luksaj@brand-design.cz"
                  class="inline-flex items-center gap-2 text-primary hover:underline w-fit"
                >
                  <EnvelopeIcon class="w-4 h-4" />
                  <span>{global.company.contactEmail}</span>
                </a>
                <a
                  href="tel:+420777135686"
                  class="inline-flex items-center gap-2 text-primary hover:underline w-fit"
                >
                  <PhoneIcon class="w-4 h-4" />
                  <span>{global.company.phone}</span>
                </a>
              </div>
              <Button
                as="a"
                href="mailto:info@brand-design.cz"
                variant="hero-primary"
                size="lg"
                class="w-full sm:w-auto mt-4 whitespace-nowrap"
              >
                {global.footer.writeMessage}
                <SendIcon class="w-5 h-5 text-white" />
              </Button>
            </div>
          </div>
        </div>
      </div>
    </div>

    <!-- Bottom Section -->
    <div
      class="border-t border-outline/20 pt-8 flex flex-col md:flex-row justify-between items-center gap-4 text-sm text-foreground/60 w-full animate-reveal-footer"
    >
      <p>{year} {global.company.name} — {global.footer.allRightsReserved}</p>
      <p>
        {global.footer.createdBy}
        <a
          href="https://lukaschylik.sk/"
          target="_blank"
          rel="noopener noreferrer"
          class="text-primary hover:underline font-medium">Lukáš Chylík</a
        >
      </p>
    </div>
  </div>
</footer>
