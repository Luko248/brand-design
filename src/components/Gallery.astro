---
export interface Props {
  images: Array<{
    thumb: string;
    full: string;
    alt?: string;
  }>;
  galleryId: string;
}

const { images, galleryId } = Astro.props;
---

<div class="grid grid-cols-[--grid-template-gallery] gap-6 py-8">
  {images.map((img, index) => (
    <a
      href={img.full}
      data-fancybox={galleryId}
      data-caption={img.alt || `Image ${index + 1}`}
      class="relative overflow-hidden rounded-lg shadow-md transition-transform duration-[--duration-300] ease-[--ease-standard] hover:-translate-y-1 hover:shadow-lg aspect-[var(--ratio-gallery)]"
    >
      <img src={img.thumb} alt={img.alt || `Thumbnail ${index + 1}`} loading="lazy" class="absolute inset-0 w-full h-full object-cover transition-transform duration-[--duration-300] ease-[--ease-standard] hover:scale-105" />
    </a>
  ))}
</div>

<script>
  import { Fancybox } from "@fancyapps/ui";
  import "@fancyapps/ui/dist/fancybox/fancybox.css";

  Fancybox.bind("[data-fancybox]", {
    // Custom options
  });
</script>

<!-- Styles fully migrated to Tailwind utilities -->
