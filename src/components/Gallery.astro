---
import IconButton from "@/components/ui/IconButton.astro";
import MagnifyIcon from "@/components/icons/MagnifyIcon.astro";

export interface Props {
  images: Array<{
    thumb: string;
    full: string;
    alt?: string;
  }>;
  galleryId: string;
}

const { images, galleryId } = Astro.props;
---

<div class="py-12">
  <div class="columns-1 sm:columns-2 lg:columns-3 gap-6 space-y-6">
    {
      images.map((img, index) => (
        <a
          href={img.full}
          data-fancybox={galleryId}
          data-caption={img.alt || ""}
          class="group relative block break-inside-avoid rounded-xl overflow-hidden bg-surface shadow-sm hover:shadow-xl transition-all duration-300 hover:-translate-y-1"
        >
          <img
            src={img.thumb}
            alt={img.alt || ""}
            loading="lazy"
            class="w-full h-auto transform transition-transform duration-500 group-hover:scale-110"
          />
          <div class="absolute inset-0 bg-black/20 opacity-0 group-hover:opacity-100 transition-opacity duration-300 flex items-center justify-center">
            <IconButton as="div" title={img.alt || ""}>
              <MagnifyIcon class="w-6 h-6" />
            </IconButton>
          </div>
        </a>
      ))
    }
  </div>
</div>

<script>
  import { Fancybox } from "@fancyapps/ui";
  import "@fancyapps/ui/dist/fancybox/fancybox.css";

  Fancybox.bind("[data-fancybox]", {
    Hash: false,
    Toolbar: {
      display: {
        left: ["infobar"],
        middle: [],
        right: ["slideshow", "thumbs", "close"],
      },
    },
  } as any);
</script>
