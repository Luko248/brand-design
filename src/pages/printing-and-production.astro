---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { loadTranslations } from "@/lib/i18n";

import { detectLocale } from "@/lib/i18n";
const lang = detectLocale(Astro.url);
const translations = await loadTranslations(lang, "pages/printing");

// Define printing gallery images
const printingImages = [
  { thumb: "/Resources/Images/Referencies/Print/printer_480.jpg", full: "/Resources/Images/Referencies/Print/printer_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/printer-2_480.jpg", full: "/Resources/Images/Referencies/Print/printer-2_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/printer-3_480.jpg", full: "/Resources/Images/Referencies/Print/printer-3_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/update-1_480.jpg", full: "/Resources/Images/Referencies/Print/update-1_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/update-2_480.jpg", full: "/Resources/Images/Referencies/Print/update-2_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/update-3_480.jpg", full: "/Resources/Images/Referencies/Print/update-3_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/update-4_480.jpg", full: "/Resources/Images/Referencies/Print/update-4_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/update-5_480.jpg", full: "/Resources/Images/Referencies/Print/update-5_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/update-6_480.jpg", full: "/Resources/Images/Referencies/Print/update-6_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Print/update-7_480.jpg", full: "/Resources/Images/Referencies/Print/update-7_1024.jpg" },
];
---

<BaseLayout lang={lang} title={translations.title} description={translations.description}>
  <header class="bg-cover bg-center aspect-[var(--ratio-hero)]" style="background-image: url('/Resources/Images/Backgrounds/print_bg.jpg')"></header>

  <Navigation lang={lang} currentPath="/printing-and-production" />

  <main>
    <section class="py-16 md:py-24 bg-background">
      <div class="max-w-screen-xl mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-white">{translations.heading}</h1>
        <p class="mt-4 text-white/80">{translations.description}</p>
        
        <Gallery images={printingImages} galleryId="printing-gallery" />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
