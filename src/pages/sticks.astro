---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { loadTranslations } from "@/lib/i18n";

import { detectLocale } from "@/lib/i18n";
const lang = detectLocale(Astro.url);
const translations = await loadTranslations(lang, "pages/sticks");

// Define sticks gallery images
const sticksImages = [
  // Autocentrum Cars Forever
  { thumb: "/images/Referencies/Sticks/Autocentrum Cars Forever/autocars-forever-1_480.jpg", full: "/images/Referencies/Sticks/Autocentrum Cars Forever/autocars-forever-1_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/Autocentrum Cars Forever/autocars-forever-2_480.jpg", full: "/images/Referencies/Sticks/Autocentrum Cars Forever/autocars-forever-2_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/Autocentrum Cars Forever/autocars-forever-3_480.jpg", full: "/images/Referencies/Sticks/Autocentrum Cars Forever/autocars-forever-3_1024.jpg" },
  // Categories and misc
  { thumb: "/images/Referencies/Sticks/Category_480.jpg", full: "/images/Referencies/Sticks/Category_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/Category-2_480.jpg", full: "/images/Referencies/Sticks/Category-2_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/Category-dilna_480.jpg", full: "/images/Referencies/Sticks/Category-dilna_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/DPD_480.jpg", full: "/images/Referencies/Sticks/DPD_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/DPD2_480.jpg", full: "/images/Referencies/Sticks/DPD2_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/DPD3_480.jpg", full: "/images/Referencies/Sticks/DPD3_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/Century21_480.jpg", full: "/images/Referencies/Sticks/Century21_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/Century21-2_480.jpg", full: "/images/Referencies/Sticks/Century21-2_1024.jpg" },
  // DPMB
  { thumb: "/images/Referencies/Sticks/DPMB/dpmb-40_480.jpg", full: "/images/Referencies/Sticks/DPMB/dpmb-40_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/DPMB/dpmb-41_480.jpg", full: "/images/Referencies/Sticks/DPMB/dpmb-41_1024.jpg" },
  { thumb: "/images/Referencies/Sticks/DPMB/DPMB-7_480.jpg", full: "/images/Referencies/Sticks/DPMB/DPMB-7_1024.jpg" },
];
---

<BaseLayout lang={lang} title={translations.title} description={translations.description}>
  <header class="bg-cover bg-center aspect-[var(--ratio-hero)]" style="background-image: url('/images/Backgrounds/stick_bg.jpg')"></header>

  <Navigation lang={lang} currentPath="/sticks" />

  <main>
    <section class="py-16 md:py-24 bg-background">
      <div class="max-w-screen-xl mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-white">{translations.heading}</h1>
        <p class="mt-4 text-white/80">{translations.description}</p>
        
        <Gallery images={sticksImages} galleryId="sticks-gallery" />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
