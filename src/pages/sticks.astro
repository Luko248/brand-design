---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { loadTranslations } from "@/lib/i18n";

import { detectLocale } from "@/lib/i18n";
const lang = detectLocale(Astro.url);
const translations = await loadTranslations(lang, "pages/sticks");

// Define sticks gallery images
const sticksImages = [
  { thumb: "/Resources/Images/Referencies/Sticks/Autocentrum Cars Forever/1_480.jpg", full: "/Resources/Images/Referencies/Sticks/Autocentrum Cars Forever/1_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/Autocentrum Cars Forever/2_480.jpg", full: "/Resources/Images/Referencies/Sticks/Autocentrum Cars Forever/2_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/Category-2_480.jpg", full: "/Resources/Images/Referencies/Sticks/Category-2_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/Category-dilna_480.jpg", full: "/Resources/Images/Referencies/Sticks/Category-dilna_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/Category_480.jpg", full: "/Resources/Images/Referencies/Sticks/Category_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/Century21-2_480.jpg", full: "/Resources/Images/Referencies/Sticks/Century21-2_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/Century21_480.jpg", full: "/Resources/Images/Referencies/Sticks/Century21_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/DPD2_480.jpg", full: "/Resources/Images/Referencies/Sticks/DPD2_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/DPD3_480.jpg", full: "/Resources/Images/Referencies/Sticks/DPD3_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/DPD_480.jpg", full: "/Resources/Images/Referencies/Sticks/DPD_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/KL2_480.jpg", full: "/Resources/Images/Referencies/Sticks/KL2_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/DPMB/1_480.jpg", full: "/Resources/Images/Referencies/Sticks/DPMB/1_1024.jpg" },
  { thumb: "/Resources/Images/Referencies/Sticks/DPMB/2_480.jpg", full: "/Resources/Images/Referencies/Sticks/DPMB/2_1024.jpg" },
];
---

<BaseLayout lang={lang} title={translations.title} description={translations.description}>
  <header class="header" style="background-image: url('/Resources/Images/Backgrounds/stick_bg.jpg')"></header>

  <Navigation lang={lang} currentPath="/sticks" />

  <main>
    <section class="section">
      <div class="container">
        <h1 class="section__title">{translations.heading}</h1>
        <p class="section__desc">{translations.description}</p>
        
        <Gallery images={sticksImages} galleryId="sticks-gallery" />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
