---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { loadTranslations, detectLocale } from "@/lib/i18n";

const lang = detectLocale(Astro.url);
const translations = await loadTranslations(lang, "pages/expositions");

// Manually list actual images from expositions
const expositionImages = [
  // Anuga
  {
    thumb: "/images/Referencies/Expositions/Anuga/Anuga-1_480.jpg",
    full: "/images/Referencies/Expositions/Anuga/Anuga-1_1024.jpg",
    alt: "Anuga",
  },
  {
    thumb: "/images/Referencies/Expositions/Anuga/Anuga-2_480.jpg",
    full: "/images/Referencies/Expositions/Anuga/Anuga-2_1024.jpg",
    alt: "Anuga",
  },
  {
    thumb: "/images/Referencies/Expositions/Anuga/Anuga-3_480.jpg",
    full: "/images/Referencies/Expositions/Anuga/Anuga-3_1024.jpg",
    alt: "Anuga",
  },
  // Brno (Boehringer)
  {
    thumb: "/images/Referencies/Expositions/Brno/Boehringer-1_480.jpg",
    full: "/images/Referencies/Expositions/Brno/Boehringer-1_1024.jpg",
    alt: "Brno",
  },
  {
    thumb: "/images/Referencies/Expositions/Brno/Boehringer-3_480.jpg",
    full: "/images/Referencies/Expositions/Brno/Boehringer-3_1024.jpg",
    alt: "Brno",
  },
  // Geneva
  {
    thumb: "/images/Referencies/Expositions/Geneva/Geneva-1_480.jpg",
    full: "/images/Referencies/Expositions/Geneva/Geneva-1_1024.jpg",
    alt: "Geneva",
  },
  {
    thumb: "/images/Referencies/Expositions/Geneva/Geneva-2_480.jpg",
    full: "/images/Referencies/Expositions/Geneva/Geneva-2_1024.jpg",
    alt: "Geneva",
  },
  // Stuttgart
  {
    thumb: "/images/Referencies/Expositions/Stuttgart/VOITEQ-1_480.jpg",
    full: "/images/Referencies/Expositions/Stuttgart/VOITEQ-1_1024.jpg",
    alt: "Stuttgart",
  },
  {
    thumb: "/images/Referencies/Expositions/Stuttgart/VOITEQ-3_480.jpg",
    full: "/images/Referencies/Expositions/Stuttgart/VOITEQ-3_1024.jpg",
    alt: "Stuttgart",
  },
  // Wien
  {
    thumb: "/images/Referencies/Expositions/Wien/wien-1_480.jpg",
    full: "/images/Referencies/Expositions/Wien/wien-1_1024.jpg",
    alt: "Wien",
  },
  {
    thumb: "/images/Referencies/Expositions/Wien/wien-2_480.jpg",
    full: "/images/Referencies/Expositions/Wien/wien-2_1024.jpg",
    alt: "Wien",
  },
];
---

<BaseLayout
  lang={lang}
  title={translations.title}
  description={translations.description}
>
  <Navigation lang={lang} currentPath="/expositions" isHomepage={false} />

  <header
    class="relative h-[40vh] min-h-[400px] flex items-center justify-center overflow-hidden"
  >
    <div
      class="absolute inset-0 bg-cover bg-center z-0"
      style="background-image: url('/images/Backgrounds/exposition_bg.jpg')"
    >
    </div>
    <div class="absolute inset-0 bg-black/60 z-10"></div>
    <div class="relative z-20 text-center px-4 max-w-4xl mx-auto">
      <span
        class="block text-primary font-bold tracking-[0.3em] uppercase mb-4 animate-slide-up"
        >{translations.heading}</span
      >
      <h1
        class="font-[Prometo-l] uppercase text-4xl md:text-6xl text-white mb-6 leading-tight animate-slide-up animation-delay-200"
      >
        {translations.title}
      </h1>
    </div>
  </header>

  <main>
    <section class="py-16 md:py-24 bg-background">
      <div class="max-w-7xl mx-auto px-4 sm:px-6 lg:px-8">
        <div class="max-w-3xl mx-auto text-center mb-16">
          <p class="text-xl text-muted font-light leading-relaxed">
            {translations.description}
          </p>
          <div class="h-1 w-20 bg-primary rounded-full mx-auto mt-8"></div>
        </div>

        <Gallery images={expositionImages} galleryId="expositions-gallery" />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
