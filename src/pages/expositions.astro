---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { loadTranslations } from "@/lib/i18n";

import { detectLocale } from "@/lib/i18n";
const lang = detectLocale(Astro.url);
const translations = await loadTranslations(lang, "pages/expositions");

// Manually list actual images from expositions
const expositionImages = [
  { thumb: "/Resources/Images/Referencies/Expositions/Anuga/1_480.jpg", full: "/Resources/Images/Referencies/Expositions/Anuga/1_1024.jpg", alt: "Anuga" },
  { thumb: "/Resources/Images/Referencies/Expositions/Anuga/2_480.jpg", full: "/Resources/Images/Referencies/Expositions/Anuga/2_1024.jpg", alt: "Anuga" },
  { thumb: "/Resources/Images/Referencies/Expositions/Brno/1_480.jpg", full: "/Resources/Images/Referencies/Expositions/Brno/1_1024.jpg", alt: "Brno" },
  { thumb: "/Resources/Images/Referencies/Expositions/Geneva/1_480.jpg", full: "/Resources/Images/Referencies/Expositions/Geneva/1_1024.jpg", alt: "Geneva" },
  { thumb: "/Resources/Images/Referencies/Expositions/Stuttgart/1_480.jpg", full: "/Resources/Images/Referencies/Expositions/Stuttgart/1_1024.jpg", alt: "Stuttgart" },
  { thumb: "/Resources/Images/Referencies/Expositions/Wien/1_480.jpg", full: "/Resources/Images/Referencies/Expositions/Wien/1_1024.jpg", alt: "Wien" },
];
---

<BaseLayout lang={lang} title={translations.title} description={translations.description}>
  <header class="header" style="background-image: url('/Resources/Images/Backgrounds/exposition_bg.jpg')"></header>

  <Navigation lang={lang} currentPath="/expositions" />

  <main>
    <section class="section">
      <div class="container">
        <h1 class="section__title">{translations.heading}</h1>
        <p class="section__desc">{translations.description}</p>
        
        <Gallery images={expositionImages} galleryId="expositions-gallery" />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
