---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import Gallery from "@/components/Gallery.astro";
import { loadTranslations } from "@/lib/i18n";

import { detectLocale } from "@/lib/i18n";
const lang = detectLocale(Astro.url);
const translations = await loadTranslations(lang, "pages/expositions");

// Manually list actual images from expositions
const expositionImages = [
  // Anuga
  { thumb: "/images/Referencies/Expositions/Anuga/Anuga-1_480.jpg", full: "/images/Referencies/Expositions/Anuga/Anuga-1_1024.jpg", alt: "Anuga" },
  { thumb: "/images/Referencies/Expositions/Anuga/Anuga-2_480.jpg", full: "/images/Referencies/Expositions/Anuga/Anuga-2_1024.jpg", alt: "Anuga" },
  { thumb: "/images/Referencies/Expositions/Anuga/Anuga-3_480.jpg", full: "/images/Referencies/Expositions/Anuga/Anuga-3_1024.jpg", alt: "Anuga" },
  // Brno (Boehringer)
  { thumb: "/images/Referencies/Expositions/Brno/Boehringer-1_480.jpg", full: "/images/Referencies/Expositions/Brno/Boehringer-1_1024.jpg", alt: "Brno" },
  { thumb: "/images/Referencies/Expositions/Brno/Boehringer-3_480.jpg", full: "/images/Referencies/Expositions/Brno/Boehringer-3_1024.jpg", alt: "Brno" },
  // Geneva
  { thumb: "/images/Referencies/Expositions/Geneva/Geneva-1_480.jpg", full: "/images/Referencies/Expositions/Geneva/Geneva-1_1024.jpg", alt: "Geneva" },
  { thumb: "/images/Referencies/Expositions/Geneva/Geneva-2_480.jpg", full: "/images/Referencies/Expositions/Geneva/Geneva-2_1024.jpg", alt: "Geneva" },
  // Stuttgart
  { thumb: "/images/Referencies/Expositions/Stuttgart/VOITEQ-1_480.jpg", full: "/images/Referencies/Expositions/Stuttgart/VOITEQ-1_1024.jpg", alt: "Stuttgart" },
  { thumb: "/images/Referencies/Expositions/Stuttgart/VOITEQ-3_480.jpg", full: "/images/Referencies/Expositions/Stuttgart/VOITEQ-3_1024.jpg", alt: "Stuttgart" },
  // Wien
  { thumb: "/images/Referencies/Expositions/Wien/wien-1_480.jpg", full: "/images/Referencies/Expositions/Wien/wien-1_1024.jpg", alt: "Wien" },
  { thumb: "/images/Referencies/Expositions/Wien/wien-2_480.jpg", full: "/images/Referencies/Expositions/Wien/wien-2_1024.jpg", alt: "Wien" },
];
---

<BaseLayout lang={lang} title={translations.title} description={translations.description}>
  <header class="bg-cover bg-center aspect-[var(--ratio-hero)]" style="background-image: url('/images/Backgrounds/exposition_bg.jpg')"></header>

  <Navigation lang={lang} currentPath="/expositions" />

  <main>
    <section class="py-16 md:py-24 bg-background">
      <div class="max-w-screen-xl mx-auto px-4">
        <h1 class="text-4xl md:text-5xl font-bold text-white">{translations.heading}</h1>
        <p class="mt-4 text-white/80">{translations.description}</p>
        
        <Gallery images={expositionImages} galleryId="expositions-gallery" />
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
