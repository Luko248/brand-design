---
import BaseLayout from "@/layouts/BaseLayout.astro";
import Navigation from "@/components/Navigation.astro";
import Footer from "@/components/Footer.astro";
import HeroSlider from "@/components/HeroSlider.astro";
import { loadTranslations } from "@/lib/i18n";

// Get language from query parameter
import { detectLocale } from "@/lib/i18n";
const lang = detectLocale(Astro.url);
const translations = await loadTranslations(lang, "pages/index");
---

<BaseLayout lang={lang}>
  <header id="Home">
    <HeroSlider
      slides={[
        {
          image: '/images/Backgrounds/slider-home-1.jpg',
          titleHtml: translations.hero.slide1.title,
          ctaText: translations.hero.slide1.button,
          ctaHref: '#About',
        },
        {
          image: '/images/Backgrounds/slider-home-2.jpg',
          titleHtml: translations.hero.slide2.title,
          ctaText: translations.hero.slide2.button,
          ctaHref: '#References',
        },
        {
          image: '/images/Backgrounds/slider-home-3.jpg',
          titleHtml: translations.hero.slide3.title,
          ctaText: translations.hero.slide3.button,
          ctaHref: '#Contact',
        },
      ]}
    />
  </header>

  <Navigation lang={lang} currentPath="/" isHomepage={true} />

  <main>
    <!-- About -->
    <section id="About" class="py-16 md:py-24 bg-background">
      <div class="max-w-screen-xl mx-auto px-4">
        <div class="grid grid-cols-1 md:grid-cols-2 gap-8 md:gap-12 items-center">
          <div class="flex items-center justify-center">
            <img
              src="/images/Logos/logo_circle.svg"
              alt="Main logo"
              class="w-[85%] md:w-1/2 sm:w-[85%] h-auto"
            />
          </div>
          <div class="py-6 text-white">
            <h1 class="main-title" set:html={translations.about.mainTitle} />
            <h2 class="font-[Prometo-l] uppercase text-4xl md:text-5xl text-white mb-6 text-left" set:html={translations.about.title} />
            <p class="text-xl md:text-2xl font-light leading-relaxed text-left mb-6 text-white/90" set:html={translations.about.paragraph1} />
            <p class="text-xl md:text-2xl font-light leading-relaxed text-left text-white/90" set:html={translations.about.paragraph2} />
          </div>
        </div>
      </div>
    </section>

    <!-- Banner CTA -->
    <section class="relative aspect-[16/9] bg-cover bg-center" style="background-image: url('/images/Backgrounds/parallax-bg-1.jpg')">
      <div class="absolute inset-0 bg-[oklch(0_0_0_/_0.9)]"></div>
      <div class="relative max-w-screen-xl mx-auto px-4 py-12 md:py-20 grid place-items-center text-center text-white">
        <div>
          <h3 class="font-[Prometo-l] uppercase text-3xl md:text-4xl" set:html={translations.banner.title} />
          <a
            href="#Contact"
            class="inline-block mt-6 md:mt-8 px-6 py-3 md:px-8 md:py-3 bg-white text-black uppercase tracking-wide hover:bg-transparent hover:text-white border border-white transition-colors duration-300"
          >
            {translations.banner.button}
          </a>
        </div>
      </div>
    </section>

    <!-- Services / References -->
    <section id="References" class="py-16 md:py-24 bg-white text-black">
      <div class="max-w-screen-xl mx-auto px-4">
        <h2 class="font-[Prometo-l] uppercase text-4xl md:text-5xl text-center mb-8">{translations.services.title}</h2>

        <!-- Printing row -->
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center mb-12">
          <a href="/printing-and-production" class="group relative block w-full max-w-xl min-h-[25rem] md:min-h-[32rem] mx-auto text-white overflow-hidden">
            <img src="/images/Backgrounds/print_bg.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.45)_0%,rgba(0,0,0,1)_100%)] opacity-100 md:opacity-0 md:group-hover:opacity-0 transition"></div>
            <div class="absolute inset-0 bg-[linear-gradient(45deg,color-mix(in_oklch,var(--color-outline),transparent_40%),color-mix(in_oklch,var(--color-primary),transparent_40%))] opacity-0 md:opacity-100 md:group-hover:opacity-100 transition"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-[87%] h-[85%] border border-white grid place-items-center opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition">
                <div class="px-4 text-center">
                  <h3 class="text-3xl md:text-4xl font-light uppercase mb-2">{translations.services.printing.title}</h3>
                  <p class="text-lg md:text-xl font-light uppercase">{translations.services.printing.button}</p>
                </div>
              </div>
            </div>
            <div class="absolute right-4 bottom-4 w-9 h-9 opacity-15 md:opacity-0 group-hover:opacity-0 transition">
              <img src="/images/Icons/view-ico.svg" alt="search-icon" class="w-full h-full" />
            </div>
          </a>
          <div>
            <h3 class="font-[Prometo-l] uppercase text-3xl md:text-4xl text-left mb-4">{translations.services.printing.title}</h3>
            <p class="text-xl md:text-2xl font-light leading-relaxed text-left" set:html={translations.services.printing.description} />
          </div>
        </div>

        <!-- Expositions row (reverse on md) -->
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center mb-12">
          <div class="order-2 md:order-1">
            <h3 class="font-[Prometo-l] uppercase text-3xl md:text-4xl text-right md:text-left mb-4">{translations.services.expositions.title}</h3>
            <p class="text-xl md:text-2xl font-light leading-relaxed text-right md:text-left" set:html={translations.services.expositions.description} />
          </div>
          <a href="/expositions" class="group order-1 md:order-2 relative block w-full max-w-xl min-h-[25rem] md:min-h-[32rem] mx-auto text-white overflow-hidden">
            <img src="/images/Backgrounds/exposition_bg.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.45)_0%,rgba(0,0,0,1)_100%)] opacity-100 md:opacity-0 md:group-hover:opacity-0 transition"></div>
            <div class="absolute inset-0 bg-[linear-gradient(45deg,color-mix(in_oklch,var(--color-outline),transparent_40%),color-mix(in_oklch,var(--color-primary),transparent_40%))] opacity-0 md:opacity-100 md:group-hover:opacity-100 transition"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-[87%] h-[85%] border border-white grid place-items-center opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition">
                <div class="px-4 text-center">
                  <h3 class="text-3xl md:text-4xl font-light uppercase mb-2">{translations.services.expositions.title}</h3>
                  <p class="text-lg md:text-xl font-light uppercase">{translations.services.expositions.button}</p>
                </div>
              </div>
            </div>
            <div class="absolute right-4 bottom-4 w-9 h-9 opacity-15 md:opacity-0 group-hover:opacity-0 transition">
              <img src="/images/Icons/view-ico.svg" alt="search-icon" class="w-full h-full" />
            </div>
          </a>
        </div>

        <!-- Sticks row -->
        <div class="grid md:grid-cols-2 gap-8 md:gap-12 items-center">
          <a href="/sticks" class="group relative block w-full max-w-xl min-h-[25rem] md:min-h-[32rem] mx-auto text-white overflow-hidden">
            <img src="/images/Backgrounds/stick_bg.jpg" alt="" class="absolute inset-0 w-full h-full object-cover" />
            <div class="absolute inset-0 bg-[radial-gradient(ellipse_at_center,rgba(0,0,0,0.45)_0%,rgba(0,0,0,1)_100%)] opacity-100 md:opacity-0 md:group-hover:opacity-0 transition"></div>
            <div class="absolute inset-0 bg-[linear-gradient(45deg,color-mix(in_oklch,var(--color-outline),transparent_40%),color-mix(in_oklch,var(--color-primary),transparent_40%))] opacity-0 md:opacity-100 md:group-hover:opacity-100 transition"></div>
            <div class="absolute inset-0 flex items-center justify-center">
              <div class="w-[87%] h-[85%] border border-white grid place-items-center opacity-0 scale-0 group-hover:opacity-100 group-hover:scale-100 transition">
                <div class="px-4 text-center">
                  <h3 class="text-3xl md:text-4xl font-light uppercase mb-2">{translations.services.sticks.title}</h3>
                  <p class="text-lg md:text-xl font-light uppercase">{translations.services.sticks.button}</p>
                </div>
              </div>
            </div>
            <div class="absolute right-4 bottom-4 w-9 h-9 opacity-15 md:opacity-0 group-hover:opacity-0 transition">
              <img src="/images/Icons/view-ico.svg" alt="search-icon" class="w-full h-full" />
            </div>
          </a>
          <div>
            <h3 class="font-[Prometo-l] uppercase text-3xl md:text-4xl text-left mb-4">{translations.services.sticks.title}</h3>
            <p class="text-xl md:text-2xl font-light leading-relaxed text-left" set:html={translations.services.sticks.description} />
          </div>
        </div>
      </div>
    </section>

    <!-- Partners -->
    <section class="py-16 md:py-24 bg-white">
      <div class="max-w-screen-xl mx-auto px-4">
        <h2 class="font-[Prometo-l] uppercase text-4xl md:text-5xl text-center mb-8">{translations.partners.title}</h2>
        <div class="flex flex-col items-center gap-6">
          <p class="text-lg md:text-xl text-center">{translations.partners.text}</p>
          <a href="https://www.mistrymont.cz/" class="block" target="_blank">
            <img src="/images/Logos/mistry-mont-logo.svg" alt="Mistry Mont Logo" class="h-12 md:h-16 w-auto" />
          </a>
        </div>
      </div>
    </section>
  </main>

  <Footer lang={lang} />
</BaseLayout>
