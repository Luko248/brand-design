---
import { loadTranslations, getLocalizedPath } from "@/lib/i18n";
import PerformanceOptimizations from "@/components/PerformanceOptimizations.astro";

export interface Props {
  title?: string;
  description?: string;
  lang?: "cs" | "en";
}

const { title, description, lang = "cs" } = Astro.props;

const global = await loadTranslations(lang, "global");
const pageTitle = title || global.site.title;
const pageDescription = description || global.site.description;

const basePath = Astro.url.pathname + Astro.url.search;
const csUrl = getLocalizedPath(basePath, "cs");
const enUrl = getLocalizedPath(basePath, "en");
const canonicalUrl = lang === "en" ? enUrl : csUrl;
---

<!doctype html>
<html lang={lang}>
  <head>
    <meta charset="utf-8" />
    <meta
      name="viewport"
      content="width=device-width, initial-scale=1.0, maximum-scale=1"
    />
    <meta http-equiv="X-UA-Compatible" content="IE=edge" />
    <title>{pageTitle}</title>
    <meta name="author" content="Lukáš Chylík" />
    <meta name="description" content={pageDescription} />
    <meta
      name="keywords"
      content="Návrg Loga Brno, Logo Brno, Návrh designu, Design Brno, Konferenční stánky, Návrh brandu, Brand, Design, Velkoplošní grafika, Polepy na auta"
    />
    <meta
      name="google-site-verification"
      content="WlojpglePdITx8NvvfRNi0UoxVJ5Ft-Yy0G-QUHjUs0"
    />

    <link rel="canonical" href={canonicalUrl} />
    <link rel="alternate" hreflang="cs" href={csUrl} />
    <link rel="alternate" hreflang="en" href={enUrl} />
    <link rel="alternate" hreflang="x-default" href={csUrl} />

    <link
      rel="icon"
      type="image/png"
      href="/images/favicons/favicon-96x96.png"
      sizes="96x96"
    />
    <link rel="icon" type="image/svg+xml" href="/images/favicons/favicon.svg" />
    <link rel="shortcut icon" href="/images/favicons/favicon.ico" />
    <link
      rel="apple-touch-icon"
      sizes="180x180"
      href="/images/favicons/apple-touch-icon.png"
    />
    <link rel="manifest" href="/images/favicons/site.webmanifest" />
    <meta name="msapplication-TileColor" content="#170f24" />
    <meta name="theme-color" content="#170f24" />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Inter:ital,opsz,wght@0,14..32,100..900;1,14..32,100..900&family=League+Spartan:wght@100..900&family=Open+Sans:ital,wght@0,300..800;1,300..800&display=swap"
      rel="stylesheet"
    />

    <!-- Schema.org markup -->
    <meta itemprop="name" content={global.company.name} />
    <meta itemprop="description" content={pageDescription} />
    <meta itemprop="image" content="/images/meta/meta-image-google.png" />

    <!-- Open Graph data -->
    <meta property="og:title" content={global.company.name} />
    <meta property="og:image" content="/images/meta/meta-image-fb.png" />
    <meta property="og:description" content={pageDescription} />

    <!-- Twitter Card data -->
    <meta name="twitter:title" content={global.company.name} />
    <meta name="twitter:description" content={pageDescription} />
    <meta name="twitter:image" content="/images/meta/meta-image-twitter.png" />

    <PerformanceOptimizations />

    <!-- Styles: Tailwind first, then global overrides -->
    <link rel="stylesheet" href="/styles/tailwind.css" />
    <link rel="stylesheet" href="/styles/global.css" />

    <!-- Theme bootstrap: initialize light/dark mode before paint -->
    <script is:inline>
      (function () {
        try {
          const root = document.documentElement;
          const stored = window.localStorage.getItem("theme");
          const prefersDark = window.matchMedia(
            "(prefers-color-scheme: dark)"
          ).matches;
          const next =
            stored === "light" || stored === "dark"
              ? stored
              : prefersDark
                ? "dark"
                : "light";
          root.dataset.theme = next;
        } catch (error) {
          // Fail silently, default CSS will be used
        }
      })();
    </script>

    <!-- Google Analytics -->
    <script
      is:inline
      async
      src="https://www.googletagmanager.com/gtag/js?id=UA-120163100-3"></script>
    <script is:inline>
      window.dataLayer = window.dataLayer || [];
      function gtag() {
        dataLayer.push(arguments);
      }
      gtag("js", new Date());
      gtag("config", "UA-120163100-3");
    </script>

    <!-- Schema.org Local Business -->
    <script
      is:inline
      type="application/ld+json"
      set:html={JSON.stringify({
        "@context": "https://schema.org",
        "@type": "LocalBusiness",
        "@id": "https://brand-design.cz/#localbusiness",
        name: global.company.name,
        description: pageDescription,
        url: "https://brand-design.cz/",
        image: "https://brand-design.cz/images/logos/logo.svg",
        telephone: global.company.phone,
        email: global.company.email,
        address: {
          "@type": "PostalAddress",
          streetAddress: global.company.street,
          addressLocality: global.company.city,
          addressRegion: "Brno",
          addressCountry: "CZ",
          postalCode: global.company.zip,
        },
        openingHoursSpecification: [
          {
            "@type": "OpeningHoursSpecification",
            dayOfWeek: [
              "Monday",
              "Tuesday",
              "Wednesday",
              "Thursday",
              "Friday",
            ],
            opens: "10:00",
            closes: "18:00",
          },
        ],
        sameAs: [
          "https://www.facebook.com/BENDER-dEsign-153757514682594/",
          "https://www.instagram.com/brand_design.cz/",
        ],
      })}
    />
  </head>
  <body
    class="bg-background text-foreground transition-colors duration-[--duration-300]"
  >
    <slot />
  </body>
</html>
